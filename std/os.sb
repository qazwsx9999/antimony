// =============================================================================
// Antimony Standard Library: std/os.sb
// Cross-platform console streams (stdin/stdout/stderr), command-line arguments,
// environment variables, and working directory utilities.
// =============================================================================

import "std/core.sb"
import "std/str.sb"
import "std/pal/os.sb"

// Writes `s` to stdout without appending a trailing newline.
pub fn print_raw(s: str) {
    if len(s) == 0 {
        return
    }
    pal_write_stdout(ptr_cast(*const u8, s), usize(len(s)))
}

// Writes `s` to stderr without appending a trailing newline.
pub fn eprint_raw(s: str) {
    if len(s) == 0 {
        return
    }
    pal_write_stderr(ptr_cast(*const u8, s), usize(len(s)))
}

// Writes `s` followed by '\n' to stderr.
pub fn eprint(s: str) {
    eprint_raw(s)
    eprint_raw("\n")
}

// Reads up to `len(buf)` bytes from stdin; returns bytes read or -1 on error.
pub fn read_stdin(buf[]: u8): i64 {
    if len(buf) == 0 {
        return 0
    }
    return pal_read_stdin(&buf[0], usize(len(buf)))
}

// Returns the raw command line of the current process as a `str`.
pub fn cmd_line(): str {
    return pal_cmd_line()
}

// Returns the number of whitespace/quote-delimited arguments in `line`.
pub fn parse_arg_count(line: str): i32 {
    var n = len(line)
    var i: i64 = 0
    var count: i32 = 0
    loop i < n {
        loop i < n && is_space(line[i]) {
            i += 1
        }
        if i >= n {
            break
        }
        count += 1
        if line[i] == '"' {
            i += 1
            loop i < n && line[i] != '"' {
                i += 1
            }
            if i < n {
                i += 1
            }
        } else {
            loop i < n && !is_space(line[i]) {
                i += 1
            }
        }
    }
    return count
}

// Returns the `index`-th argument from `line` (stripping surrounding quotes if present).
pub fn parse_arg_at(line: str, index: i32): str {
    var n = len(line)
    var i: i64 = 0
    var cur: i32 = 0
    loop i < n {
        loop i < n && is_space(line[i]) {
            i += 1
        }
        if i >= n {
            break
        }
        var start = i
        var end = i
        if line[i] == '"' {
            i += 1
            start = i
            loop i < n && line[i] != '"' {
                i += 1
            }
            end = i
            if i < n {
                i += 1
            }
        } else {
            loop i < n && !is_space(line[i]) {
                i += 1
            }
            end = i
        }
        if cur == index {
            return line[start..end]
        }
        cur += 1
    }
    return ""
}

// Returns the number of command-line arguments passed to the current process.
pub fn arg_count(): i32 {
    if pal_use_parsed_args() {
        return parse_arg_count(cmd_line())
    }
    return pal_arg_count()
}

// Returns the `index`-th command-line argument of the current process.
pub fn arg_at(index: i32): str {
    if pal_use_parsed_args() {
        return parse_arg_at(cmd_line(), index)
    }
    return pal_arg_at(index)
}

// Reads environment variable `name` into `buf[]` and returns the populated `str` slice (or "" if unset).
pub fn getenv_into(name: *const u8, buf[]: u8): str {
    if len(buf) == 0 {
        return ""
    }
    var n = pal_getenv_into(name, &buf[0], usize(len(buf)))
    if n <= 0 || n >= len(buf) {
        return ""
    }
    return str(buf[0..n])
}

// Reads environment variable `name` (Antimony `str`) into `buf[]`.
pub fn getenv_str(name: str, buf[]: u8): Option[str] {
    if len(name) == 0 || len(buf) == 0 {
        return .None
    }
    var nb: StringBuilder
    nb.init(usize(len(name)) + 1)
    defer nb.free()
    nb.append(name)
    var n = pal_getenv_into(nb.cstr(), &buf[0], usize(len(buf)))
    if n < 0 || n >= len(buf) {
        return .None
    }
    return .Some(str(buf[0..n]))
}

// Reads the current working directory into `buf[]`.
pub fn cwd_into(buf[]: u8): Option[str] {
    if len(buf) == 0 {
        return .None
    }
    var n = pal_cwd_into(&buf[0], usize(len(buf)))
    if n <= 0 || n >= len(buf) {
        return .None
    }
    return .Some(str(buf[0..n]))
}
