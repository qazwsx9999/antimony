// =============================================================================
// Antimony Standard Library: std/io.sb
// Cross-platform file I/O (`File`, `IoError`, `SeekFrom`, `Result`-based APIs,
// plus zero-overhead low-level helpers).
// =============================================================================

import "std/core.sb"
import "std/mem.sb"
import "std/str.sb"
import "std/pal/io.sb"

const WIN32_ERR_FILE_NOT_FOUND: u32 = 2
const WIN32_ERR_PATH_NOT_FOUND: u32 = 3
const WIN32_ERR_ACCESS_DENIED: u32 = 5
const WIN32_ERR_FILE_EXISTS: u32 = 80
const WIN32_ERR_BROKEN_PIPE: u32 = 109
const WIN32_ERR_ALREADY_EXISTS: u32 = 183

// -----------------------------------------------------------------------------
// Structured I/O Error & Seek Types
// -----------------------------------------------------------------------------

pub enum IoError {
    NotFound
    PermissionDenied
    AlreadyExists
    InvalidInput
    BrokenPipe
    UnexpectedEof
    OsError(u32)
}

pub fn io_error_from_win32(code: u32): IoError {
    match code {
        WIN32_ERR_FILE_NOT_FOUND, WIN32_ERR_PATH_NOT_FOUND { return .NotFound }
        WIN32_ERR_ACCESS_DENIED { return .PermissionDenied }
        WIN32_ERR_FILE_EXISTS, WIN32_ERR_ALREADY_EXISTS { return .AlreadyExists }
        WIN32_ERR_BROKEN_PIPE { return .BrokenPipe }
        else { return .OsError(code) }
    }
}

pub fn io_error_from_os(code: u32): IoError {
    match pal_classify_os_error(code) {
        1 { return .NotFound }
        2 { return .PermissionDenied }
        3 { return .AlreadyExists }
        4 { return .InvalidInput }
        5 { return .BrokenPipe }
        else { return .OsError(code) }
    }
}

pub fn (e: IoError) message(): str {
    match e {
        .NotFound { return "file or path not found" }
        .PermissionDenied { return "permission denied" }
        .AlreadyExists { return "already exists" }
        .InvalidInput { return "invalid input" }
        .BrokenPipe { return "broken pipe" }
        .UnexpectedEof { return "unexpected end of file" }
        .OsError(_) { return "OS I/O error" }
    }
}

pub enum SeekFrom {
    Start(i64)
    Current(i64)
    End(i64)
}

// -----------------------------------------------------------------------------
// Rust/Go-Style `File` Handle
// -----------------------------------------------------------------------------

pub struct File {
    handle: isize
}

priv fn open_file_mode(path: str, mode: i32): Result[File, IoError] {
    if len(path) == 0 {
        return .Err(.InvalidInput)
    }
    var pb: StringBuilder
    pb.init(usize(len(path)) + 1)
    defer pb.free()
    pb.append(path)
    var h = pal_file_open(pb.cstr(), mode)
    if !pal_file_is_open(h) {
        return .Err(io_error_from_os(pal_last_os_error()))
    }
    return .Ok(File { handle: h })
}

// Opens an existing file for reading.
pub fn file_open(path: str): Result[File, IoError] {
    return open_file_mode(path, 0)
}

// Creates a new file (or truncates an existing one) for writing.
pub fn file_create(path: str): Result[File, IoError] {
    return open_file_mode(path, 1)
}

// Opens a file for appending (creating it if it does not exist).
pub fn file_open_append(path: str): Result[File, IoError] {
    return open_file_mode(path, 2)
}

// Opens a file for reading and writing (creating it if it does not exist).
pub fn file_open_rw(path: str): Result[File, IoError] {
    return open_file_mode(path, 3)
}

pub fn (f: *File) is_open(): bool {
    return pal_file_is_open(f.handle)
}

pub fn (f: *File) read(buf[]: u8): Result[i64, IoError] {
    if !f.is_open() {
        return .Err(.InvalidInput)
    }
    if len(buf) == 0 {
        return .Ok(0)
    }
    var nread = pal_file_read(f.handle, &buf[0], usize(len(buf)))
    if nread < 0 {
        return .Err(io_error_from_os(pal_last_os_error()))
    }
    return .Ok(nread)
}

pub fn (f: *File) write(data[]: const u8): Result[i64, IoError] {
    if !f.is_open() {
        return .Err(.InvalidInput)
    }
    if len(data) == 0 {
        return .Ok(0)
    }
    var written = pal_file_write(f.handle, &data[0], usize(len(data)))
    if written < 0 {
        return .Err(io_error_from_os(pal_last_os_error()))
    }
    return .Ok(written)
}

pub fn (f: *File) write_all(data[]: const u8): Result[i64, IoError] {
    var total = len(data)
    var off: i64 = 0
    loop off < total {
        var n = f.write(data[off..total])?
        if n <= 0 {
            return .Err(.UnexpectedEof)
        }
        off += n
    }
    return .Ok(off)
}

pub fn (f: *File) write_str(s: str): Result[i64, IoError] {
    if len(s) == 0 {
        return .Ok(0)
    }
    var p = ptr_cast(*const u8, s)
    return f.write_all(p[0..len(s)])
}

pub fn (f: *File) seek(pos: SeekFrom): Result[i64, IoError] {
    if !f.is_open() {
        return .Err(.InvalidInput)
    }
    var dist: i64 = 0
    var whence: i32 = 0
    match pos {
        .Start(o) {
            dist = o
            whence = 0
        }
        .Current(o) {
            dist = o
            whence = 1
        }
        .End(o) {
            dist = o
            whence = 2
        }
    }
    var new_pos = pal_file_seek(f.handle, dist, whence)
    if new_pos < 0 {
        return .Err(io_error_from_os(pal_last_os_error()))
    }
    return .Ok(new_pos)
}

pub fn (f: *File) size(): Result[i64, IoError] {
    if !f.is_open() {
        return .Err(.InvalidInput)
    }
    var sz = pal_file_size(f.handle)
    if sz < 0 {
        return .Err(io_error_from_os(pal_last_os_error()))
    }
    return .Ok(sz)
}

pub fn (f: *File) flush(): Result[bool, IoError] {
    if !f.is_open() {
        return .Err(.InvalidInput)
    }
    if !pal_file_flush(f.handle) {
        return .Err(io_error_from_os(pal_last_os_error()))
    }
    return .Ok(true)
}

pub fn (f: *File) close() {
    if f.is_open() {
        pal_file_close(f.handle)
        f.handle = PAL_INVALID_HANDLE
    }
}

// -----------------------------------------------------------------------------
// High-Level Whole-File Helpers (`str` paths, `Result`-based)
// -----------------------------------------------------------------------------

// Reads the entire contents of `path` and appends them to `out`, returning bytes read.
pub fn read_file_all(path: str, out: *StringBuilder): Result[i64, IoError] {
    var f = file_open(path)?
    defer f.close()

    var sz = f.size()?
    if sz > 0 {
        out.ensure(usize(sz))
    }

    var chunk[4096]: u8
    var total: i64 = 0
    loop {
        var n = f.read(chunk)?
        if n == 0 {
            break
        }
        out.append_bytes(chunk[0..n])
        total += n
    }
    return .Ok(total)
}

// Writes `content` to `path` (creating or overwriting the file), returning bytes written.
pub fn write_file_all(path: str, content: str): Result[i64, IoError] {
    var f = file_create(path)?
    defer f.close()
    return f.write_str(content)
}

// -----------------------------------------------------------------------------
// Legacy Low-Level Helpers (preserved for zero-allocation C-string callers)
// -----------------------------------------------------------------------------

// Writes `n` bytes from `data` to `path` (creating or overwriting the file).
pub fn write_file_ptr(path: *const u8, data: *const u8, n: u32): bool {
    var h = pal_file_open(path, 1)
    if !pal_file_is_open(h) {
        return false
    }
    defer pal_file_close(h)
    if n == 0 {
        return true
    }
    var off: usize = 0
    var total = usize(n)
    loop off < total {
        var w = pal_file_write(h, data + off, total - off)
        if w <= 0 {
            return false
        }
        off += usize(w)
    }
    return true
}

// Writes a byte slice `data[]` to `path`.
pub fn write_file_bytes(path: *const u8, data[]: const u8): bool {
    if len(data) == 0 {
        return write_file_ptr(path, null, 0)
    }
    return write_file_ptr(path, &data[0], u32(len(data)))
}

// Writes a `str` directly to `path`.
pub fn write_file_str(path: *const u8, content: str): bool {
    if len(content) == 0 {
        return write_file_ptr(path, null, 0)
    }
    return write_file_ptr(path, ptr_cast(*const u8, content), u32(len(content)))
}

// Returns the size in bytes of `path`, or -1 if the file cannot be opened.
pub fn file_size(path: *const u8): i64 {
    var h = pal_file_open(path, 0)
    if !pal_file_is_open(h) {
        return -1
    }
    defer pal_file_close(h)
    return pal_file_size(h)
}

// Reads up to `len(buf)` bytes from `path` into `buf[]`. Returns bytes read, or -1 on error.
pub fn read_file_into(path: *const u8, buf[]: u8): i64 {
    if len(buf) == 0 {
        return 0
    }
    var h = pal_file_open(path, 0)
    if !pal_file_is_open(h) {
        return -1
    }
    defer pal_file_close(h)
    return pal_file_read(h, &buf[0], usize(len(buf)))
}

// Deletes the file at `path`; returns true on success.
pub fn delete_file(path: *const u8): bool {
    return pal_delete_file(path)
}
