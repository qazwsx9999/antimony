// =============================================================================
// Antimony Standard Library: std/net.sb
// Cross-platform IPv4 TCP & UDP networking (`Ipv4Addr`, `SocketAddr`,
// `TcpListener`, `TcpStream`, `UdpSocket`, `dns_resolve`, `NetError`).
// =============================================================================

import "std/core.sb"
import "std/str.sb"
import "std/pal/net.sb"

const AF_INET: i32 = 2

priv struct SockAddrIn {
    sin_family: u16
    sin_port: u16
    sin_addr: u32
    sin_zero[8]: u8
}

priv fn ensure_net(): Result[bool, NetError] {
    var rc = pal_net_init()
    if rc != 0 {
        return .Err(.WsaError(rc))
    }
    return .Ok(true)
}

// -----------------------------------------------------------------------------
// Structured Network Errors
// -----------------------------------------------------------------------------

pub enum NetError {
    InvalidAddress
    AddrInUse
    ConnectionRefused
    ConnectionReset
    TimedOut
    WouldBlock
    UnexpectedEof
    WsaError(i32)
}

priv fn net_error_from_os(code: i32): NetError {
    match pal_net_classify_error(code) {
        1 { return .AddrInUse }
        2 { return .ConnectionRefused }
        3 { return .ConnectionReset }
        4 { return .TimedOut }
        5 { return .WouldBlock }
        else { return .WsaError(code) }
    }
}

pub fn (e: NetError) message(): str {
    match e {
        .InvalidAddress { return "invalid network address" }
        .AddrInUse { return "address already in use" }
        .ConnectionRefused { return "connection refused" }
        .ConnectionReset { return "connection reset" }
        .TimedOut { return "operation timed out" }
        .WouldBlock { return "operation would block" }
        .UnexpectedEof { return "unexpected end of stream" }
        .WsaError(_) { return "OS network error" }
    }
}

// -----------------------------------------------------------------------------
// IPv4 & Socket Addresses
// -----------------------------------------------------------------------------

pub struct Ipv4Addr {
    a: u8
    b: u8
    c: u8
    d: u8
}

pub fn ipv4(a: u8, b: u8, c: u8, d: u8): Ipv4Addr {
    return Ipv4Addr { a: a, b: b, c: c, d: d }
}

pub fn ipv4_localhost(): Ipv4Addr {
    return Ipv4Addr { a: 127, b: 0, c: 0, d: 1 }
}

pub fn ipv4_any(): Ipv4Addr {
    return Ipv4Addr { a: 0, b: 0, c: 0, d: 0 }
}

pub fn (ip: Ipv4Addr) eq(other: Ipv4Addr): bool {
    return ip.a == other.a && ip.b == other.b && ip.c == other.c && ip.d == other.d
}

pub fn (ip: Ipv4Addr) format_into(sb: *StringBuilder) {
    sb.append_u64(u64(ip.a))
    sb.append_byte('.')
    sb.append_u64(u64(ip.b))
    sb.append_byte('.')
    sb.append_u64(u64(ip.c))
    sb.append_byte('.')
    sb.append_u64(u64(ip.d))
}

// Parses a dotted-quad IPv4 address such as `"127.0.0.1"`.
pub fn ipv4_parse(s: str): Result[Ipv4Addr, NetError] {
    var octets[4]: u8 = []
    var cur = s
    loop idx in 0..4 {
        var part = cur
        if idx < 3 {
            var dot = str_find_byte(cur, '.')
            if dot <= 0 {
                return .Err(.InvalidAddress)
            }
            part = cur[0..dot]
            cur = cur[dot + 1..len(cur)]
        }
        if len(part) == 0 || len(part) > 3 {
            return .Err(.InvalidAddress)
        }
        var val: u32 = 0
        loop i in 0..len(part) {
            var c = part[i]
            if !is_digit(c) {
                return .Err(.InvalidAddress)
            }
            val = val * 10 + u32(c - '0')
        }
        if val > 255 {
            return .Err(.InvalidAddress)
        }
        octets[idx] = u8(val)
    }
    return .Ok(Ipv4Addr { a: octets[0], b: octets[1], c: octets[2], d: octets[3] })
}

pub struct SocketAddr {
    ip: Ipv4Addr
    port: u16
}

pub fn socket_addr(ip: Ipv4Addr, port: u16): SocketAddr {
    return SocketAddr { ip: ip, port: port }
}

// Parses `"a.b.c.d:port"` (e.g. `"127.0.0.1:8080"`).
pub fn socket_addr_parse(s: str): Result[SocketAddr, NetError] {
    var colon = str_rfind_byte(s, ':')
    if colon <= 0 || colon + 1 >= len(s) {
        return .Err(.InvalidAddress)
    }
    var ip = ipv4_parse(s[0..colon])?
    var port_str = s[colon + 1..len(s)]
    match try_parse_u64(port_str) {
        .Ok(p) {
            if p > 65535 {
                return .Err(.InvalidAddress)
            }
            return .Ok(SocketAddr { ip: ip, port: u16(p) })
        }
        .Err(_) {
            return .Err(.InvalidAddress)
        }
    }
}

priv fn htons(v: u16): u16 {
    return ((v & 0x00FF) << 8) | ((v >> 8) & 0x00FF)
}

priv fn to_sockaddr_in(addr: SocketAddr): SockAddrIn {
    var ip_net: u32 = u32(addr.ip.a) |
        (u32(addr.ip.b) << 8) |
        (u32(addr.ip.c) << 16) |
        (u32(addr.ip.d) << 24)
    return SockAddrIn {
        sin_family: u16(AF_INET),
        sin_port: htons(addr.port),
        sin_addr: ip_net
    }
}

priv fn from_sockaddr_in(sa: SockAddrIn): SocketAddr {
    var ip = Ipv4Addr {
        a: u8(sa.sin_addr & 0xFF),
        b: u8((sa.sin_addr >> 8) & 0xFF),
        c: u8((sa.sin_addr >> 16) & 0xFF),
        d: u8((sa.sin_addr >> 24) & 0xFF)
    }
    return SocketAddr { ip: ip, port: htons(sa.sin_port) }
}

priv fn sock_local_addr(sock: usize): Result[SocketAddr, NetError] {
    var sa = SockAddrIn {}
    var slen: i32 = i32(sizeof(SockAddrIn))
    if !pal_sock_getsockname(sock, ptr_cast(*u8, &sa), &slen) {
        return .Err(net_error_from_os(pal_net_last_error()))
    }
    return .Ok(from_sockaddr_in(sa))
}

// -----------------------------------------------------------------------------
// TCP Stream (`TcpStream`)
// -----------------------------------------------------------------------------

pub struct TcpStream {
    sock: usize
}

// Connects a TCP stream to `addr`.
pub fn tcp_connect(addr: SocketAddr): Result[TcpStream, NetError] {
    ensure_net()?
    var s = pal_sock_open_tcp()
    if !pal_sock_is_open(s) {
        return .Err(net_error_from_os(pal_net_last_error()))
    }
    var sa = to_sockaddr_in(addr)
    if !pal_sock_connect(s, ptr_cast(*const u8, &sa), i32(sizeof(SockAddrIn))) {
        var err = pal_net_last_error()
        pal_sock_close(s)
        return .Err(net_error_from_os(err))
    }
    return .Ok(TcpStream { sock: s })
}

// Resolves a hostname (or IPv4 literal) to an `Ipv4Addr` via `getaddrinfo`.
pub fn dns_resolve(host: str): Result[Ipv4Addr, NetError] {
    if len(host) == 0 {
        return .Err(.InvalidAddress)
    }
    match ipv4_parse(host) {
        .Ok(ip) { return .Ok(ip) }
        .Err(_) {}
    }
    ensure_net()?
    var hb: StringBuilder
    hb.init(usize(len(host)) + 1)
    defer hb.free()
    hb.append(host)

    var ip_net: u32 = 0
    if !pal_dns_resolve_ipv4(hb.cstr(), &ip_net) {
        return .Err(.InvalidAddress)
    }
    return .Ok(Ipv4Addr {
            a: u8(ip_net & 0xFF),
            b: u8((ip_net >> 8) & 0xFF),
            c: u8((ip_net >> 16) & 0xFF),
            d: u8((ip_net >> 24) & 0xFF)
    })
}

// Resolves `host` via DNS and opens a TCP connection to `host:port`.
pub fn tcp_connect_host(host: str, port: u16): Result[TcpStream, NetError] {
    var ip = dns_resolve(host)?
    return tcp_connect(socket_addr(ip, port))
}

pub fn (s: *TcpStream) is_open(): bool {
    return pal_sock_is_open(s.sock)
}

pub fn (s: *TcpStream) read(buf[]: u8): Result[i64, NetError] {
    if !s.is_open() {
        return .Err(.InvalidAddress)
    }
    if len(buf) == 0 {
        return .Ok(0)
    }
    var n = pal_sock_recv(s.sock, &buf[0], usize(len(buf)))
    if n < 0 {
        return .Err(net_error_from_os(pal_net_last_error()))
    }
    return .Ok(n)
}

// Reads until `buf[]` is completely filled or returns `.Err(.UnexpectedEof)` on early EOF.
pub fn (s: *TcpStream) read_exact(buf[]: u8): Result[i64, NetError] {
    var total = len(buf)
    var off: i64 = 0
    loop off < total {
        var n = s.read(buf[off..total])?
        if n == 0 {
            return .Err(.UnexpectedEof)
        }
        off += n
    }
    return .Ok(off)
}

pub fn (s: *TcpStream) write(data[]: const u8): Result[i64, NetError] {
    if !s.is_open() {
        return .Err(.InvalidAddress)
    }
    if len(data) == 0 {
        return .Ok(0)
    }
    var n = pal_sock_send(s.sock, &data[0], usize(len(data)))
    if n < 0 {
        return .Err(net_error_from_os(pal_net_last_error()))
    }
    return .Ok(n)
}

pub fn (s: *TcpStream) write_all(data[]: const u8): Result[i64, NetError] {
    var total = len(data)
    var off: i64 = 0
    loop off < total {
        var n = s.write(data[off..total])?
        if n <= 0 {
            return .Err(.UnexpectedEof)
        }
        off += n
    }
    return .Ok(off)
}

pub fn (s: *TcpStream) write_str(text: str): Result[i64, NetError] {
    if len(text) == 0 {
        return .Ok(0)
    }
    var p = ptr_cast(*const u8, text)
    return s.write_all(p[0..len(text)])
}

pub fn (s: *TcpStream) set_nodelay(enabled: bool): Result[bool, NetError] {
    if !pal_sock_set_nodelay(s.sock, enabled) {
        return .Err(net_error_from_os(pal_net_last_error()))
    }
    return .Ok(true)
}

pub fn (s: *TcpStream) set_read_timeout(ms: u32): Result[bool, NetError] {
    if !pal_sock_set_read_timeout(s.sock, ms) {
        return .Err(net_error_from_os(pal_net_last_error()))
    }
    return .Ok(true)
}

pub fn (s: *TcpStream) set_write_timeout(ms: u32): Result[bool, NetError] {
    if !pal_sock_set_write_timeout(s.sock, ms) {
        return .Err(net_error_from_os(pal_net_last_error()))
    }
    return .Ok(true)
}

pub fn (s: *TcpStream) shutdown_write(): Result[bool, NetError] {
    if !s.is_open() {
        return .Err(.InvalidAddress)
    }
    if !pal_sock_shutdown_write(s.sock) {
        return .Err(net_error_from_os(pal_net_last_error()))
    }
    return .Ok(true)
}

pub fn (s: *TcpStream) peer_addr(): Result[SocketAddr, NetError] {
    var sa = SockAddrIn {}
    var slen: i32 = i32(sizeof(SockAddrIn))
    if !pal_sock_getpeername(s.sock, ptr_cast(*u8, &sa), &slen) {
        return .Err(net_error_from_os(pal_net_last_error()))
    }
    return .Ok(from_sockaddr_in(sa))
}

pub fn (s: *TcpStream) close() {
    if s.is_open() {
        pal_sock_close(s.sock)
        s.sock = PAL_INVALID_SOCK
    }
}

// -----------------------------------------------------------------------------
// TCP Listener (`TcpListener`)
// -----------------------------------------------------------------------------

pub struct TcpListener {
    sock: usize
}

// Binds a TCP listener to `addr` (pass port `0` for an OS-assigned ephemeral port).
pub fn tcp_bind(addr: SocketAddr): Result[TcpListener, NetError] {
    ensure_net()?
    var s = pal_sock_open_tcp()
    if !pal_sock_is_open(s) {
        return .Err(net_error_from_os(pal_net_last_error()))
    }
    pal_sock_set_reuseaddr(s, true)

    var sa = to_sockaddr_in(addr)
    if !pal_sock_bind(s, ptr_cast(*const u8, &sa), i32(sizeof(SockAddrIn))) {
        var err = pal_net_last_error()
        pal_sock_close(s)
        return .Err(net_error_from_os(err))
    }
    if !pal_sock_listen(s, 128) {
        var err = pal_net_last_error()
        pal_sock_close(s)
        return .Err(net_error_from_os(err))
    }
    return .Ok(TcpListener { sock: s })
}

pub fn (l: *TcpListener) local_addr(): Result[SocketAddr, NetError] {
    return sock_local_addr(l.sock)
}

pub fn (l: *TcpListener) accept(): Result[TcpStream, NetError] {
    var sa = SockAddrIn {}
    var slen: i32 = i32(sizeof(SockAddrIn))
    var client = pal_sock_accept(l.sock, ptr_cast(*u8, &sa), &slen)
    if !pal_sock_is_open(client) {
        return .Err(net_error_from_os(pal_net_last_error()))
    }
    return .Ok(TcpStream { sock: client })
}

pub fn (l: *TcpListener) close() {
    if pal_sock_is_open(l.sock) {
        pal_sock_close(l.sock)
        l.sock = PAL_INVALID_SOCK
    }
}

// -----------------------------------------------------------------------------
// UDP Socket (`UdpSocket`)
// -----------------------------------------------------------------------------

pub struct UdpPacket {
    len: i64
    from: SocketAddr
}

pub struct UdpSocket {
    sock: usize
}

// Binds a UDP socket to `addr` (pass port `0` for an OS-assigned ephemeral port).
pub fn udp_bind(addr: SocketAddr): Result[UdpSocket, NetError] {
    ensure_net()?
    var s = pal_sock_open_udp()
    if !pal_sock_is_open(s) {
        return .Err(net_error_from_os(pal_net_last_error()))
    }
    var sa = to_sockaddr_in(addr)
    if !pal_sock_bind(s, ptr_cast(*const u8, &sa), i32(sizeof(SockAddrIn))) {
        var err = pal_net_last_error()
        pal_sock_close(s)
        return .Err(net_error_from_os(err))
    }
    return .Ok(UdpSocket { sock: s })
}

pub fn (u: *UdpSocket) local_addr(): Result[SocketAddr, NetError] {
    return sock_local_addr(u.sock)
}

pub fn (u: *UdpSocket) send_to(data[]: const u8, dest: SocketAddr): Result[i64, NetError] {
    var sa = to_sockaddr_in(dest)
    var ptr: *const u8 = null
    if len(data) > 0 {
        ptr = &data[0]
    }
    var n = pal_sock_sendto(u.sock, ptr, usize(len(data)), ptr_cast(*const u8, &sa), i32(sizeof(SockAddrIn)))
    if n < 0 {
        return .Err(net_error_from_os(pal_net_last_error()))
    }
    return .Ok(n)
}

pub fn (u: *UdpSocket) send_str_to(text: str, dest: SocketAddr): Result[i64, NetError] {
    if len(text) == 0 {
        var empty: *const u8 = null
        return u.send_to(empty[0..0], dest)
    }
    var p = ptr_cast(*const u8, text)
    return u.send_to(p[0..len(text)], dest)
}

pub fn (u: *UdpSocket) recv_from(buf[]: u8): Result[UdpPacket, NetError] {
    var sa = SockAddrIn {}
    var slen: i32 = i32(sizeof(SockAddrIn))
    var ptr: *u8 = null
    if len(buf) > 0 {
        ptr = &buf[0]
    }
    var n = pal_sock_recvfrom(u.sock, ptr, usize(len(buf)), ptr_cast(*u8, &sa), &slen)
    if n < 0 {
        return .Err(net_error_from_os(pal_net_last_error()))
    }
    return .Ok(UdpPacket { len: n, from: from_sockaddr_in(sa) })
}

pub fn (u: *UdpSocket) set_read_timeout(ms: u32): Result[bool, NetError] {
    if !pal_sock_set_read_timeout(u.sock, ms) {
        return .Err(net_error_from_os(pal_net_last_error()))
    }
    return .Ok(true)
}

pub fn (u: *UdpSocket) close() {
    if pal_sock_is_open(u.sock) {
        pal_sock_close(u.sock)
        u.sock = PAL_INVALID_SOCK
    }
}
