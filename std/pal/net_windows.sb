// =============================================================================
// Antimony PAL: std/pal/net_windows.sb
// Winsock2 (ws2_32.dll) IPv4 TCP/UDP socket and DNS primitives.
// =============================================================================

import "std/str.sb"

const PAL_NET_AF_INET: i32 = 2
const PAL_NET_SOCK_STREAM: i32 = 1
const PAL_NET_SOCK_DGRAM: i32 = 2
const PAL_NET_IPPROTO_TCP: i32 = 6
const PAL_NET_IPPROTO_UDP: i32 = 17
const PAL_NET_SOL_SOCKET: i32 = 0xFFFF
const PAL_NET_SO_REUSEADDR: i32 = 0x0004
const PAL_NET_SO_SNDTIMEO: i32 = 0x1005
const PAL_NET_SO_RCVTIMEO: i32 = 0x1006
const PAL_NET_TCP_NODELAY: i32 = 0x0001
const PAL_NET_SD_SEND: i32 = 1

const PAL_NET_WSAEWOULDBLOCK: i32 = 10035
const PAL_NET_WSAEADDRINUSE: i32 = 10048
const PAL_NET_WSAECONNABORTED: i32 = 10053
const PAL_NET_WSAECONNRESET: i32 = 10054
const PAL_NET_WSAETIMEDOUT: i32 = 10060
const PAL_NET_WSAECONNREFUSED: i32 = 10061

priv struct WinSockAddrIn {
    sin_family: u16
    sin_port: u16
    sin_addr: u32
    sin_zero[8]: u8
}

priv struct WinAddrInfoA {
    ai_flags: i32
    ai_family: i32
    ai_socktype: i32
    ai_protocol: i32
    ai_addrlen: usize
    ai_canonname: *u8
    ai_addr: *u8
    ai_next: *u8
}

priv extern "ws2_32.dll" {
    fn WSAStartup(wVersionRequested: u16, lpWSAData: *u8): i32
    fn WSAGetLastError(): i32
    fn getaddrinfo(pNodeName: *const u8, pServiceName: *const u8, pHints: *const u8, ppResult: *usize): i32
    fn freeaddrinfo(pAddrInfo: usize)
    fn socket(af: i32, sock_type: i32, protocol: i32): usize
    fn bind(s: usize, name: *const u8, namelen: i32): i32
    fn listen(s: usize, backlog: i32): i32
    fn accept(s: usize, addr: *u8, addrlen: *i32): usize
    fn connect(s: usize, name: *const u8, namelen: i32): i32
    fn send(s: usize, buf: *const u8, len: i32, flags: i32): i32
    fn recv(s: usize, buf: *u8, len: i32, flags: i32): i32
    fn sendto(s: usize, buf: *const u8, len: i32, flags: i32, to: *const u8, tolen: i32): i32
    fn recvfrom(s: usize, buf: *u8, len: i32, flags: i32, from: *u8, fromlen: *i32): i32
    fn setsockopt(s: usize, level: i32, optname: i32, optval: *const u8, optlen: i32): i32
    fn getsockname(s: usize, name: *u8, namelen: *i32): i32
    fn getpeername(s: usize, name: *u8, namelen: *i32): i32
    fn shutdown(s: usize, how: i32): i32
    fn closesocket(s: usize): i32
}

pub const PAL_INVALID_SOCK: usize = 0xFFFFFFFFFFFFFFFF

priv var g_wsa_ready: i64 = 0

// Returns 0 on success or positive WSAStartup error code on failure.
pub fn pal_net_init(): i32 {
    if atomic_load(&g_wsa_ready) != 0 {
        return 0
    }
    var wsa_data[512]: u8 = []
    var rc = WSAStartup(0x0202, &wsa_data[0])
    if rc != 0 {
        return rc
    }
    atomic_store(&g_wsa_ready, 1)
    return 0
}

pub fn pal_net_last_error(): i32 {
    return WSAGetLastError()
}

// Portable NetError classification:
// 1=AddrInUse, 2=ConnectionRefused, 3=ConnectionReset, 4=TimedOut, 5=WouldBlock, 0=Other
pub fn pal_net_classify_error(code: i32): i32 {
    match code {
        PAL_NET_WSAEADDRINUSE { return 1 }
        PAL_NET_WSAECONNREFUSED { return 2 }
        PAL_NET_WSAECONNRESET, PAL_NET_WSAECONNABORTED { return 3 }
        PAL_NET_WSAETIMEDOUT { return 4 }
        PAL_NET_WSAEWOULDBLOCK { return 5 }
        else { return 0 }
    }
}

pub fn pal_sock_is_open(sock: usize): bool {
    return sock != PAL_INVALID_SOCK && sock != 0
}

pub fn pal_sock_open_tcp(): usize {
    return socket(PAL_NET_AF_INET, PAL_NET_SOCK_STREAM, PAL_NET_IPPROTO_TCP)
}

pub fn pal_sock_open_udp(): usize {
    return socket(PAL_NET_AF_INET, PAL_NET_SOCK_DGRAM, PAL_NET_IPPROTO_UDP)
}

pub fn pal_sock_close(sock: usize) {
    if pal_sock_is_open(sock) {
        closesocket(sock)
    }
}

pub fn pal_sock_set_reuseaddr(sock: usize, enabled: bool): bool {
    var v: u32 = 0
    if enabled {
        v = 1
    }
    return setsockopt(sock, PAL_NET_SOL_SOCKET, PAL_NET_SO_REUSEADDR, ptr_cast(*const u8, &v), 4) == 0
}

pub fn pal_sock_set_nodelay(sock: usize, enabled: bool): bool {
    var v: u32 = 0
    if enabled {
        v = 1
    }
    return setsockopt(sock, PAL_NET_IPPROTO_TCP, PAL_NET_TCP_NODELAY, ptr_cast(*const u8, &v), 4) == 0
}

pub fn pal_sock_set_read_timeout(sock: usize, ms: u32): bool {
    var v = ms
    return setsockopt(sock, PAL_NET_SOL_SOCKET, PAL_NET_SO_RCVTIMEO, ptr_cast(*const u8, &v), 4) == 0
}

pub fn pal_sock_set_write_timeout(sock: usize, ms: u32): bool {
    var v = ms
    return setsockopt(sock, PAL_NET_SOL_SOCKET, PAL_NET_SO_SNDTIMEO, ptr_cast(*const u8, &v), 4) == 0
}

pub fn pal_sock_bind(sock: usize, sa: *const u8, slen: i32): bool {
    return bind(sock, sa, slen) == 0
}

pub fn pal_sock_listen(sock: usize, backlog: i32): bool {
    return listen(sock, backlog) == 0
}

pub fn pal_sock_accept(sock: usize, sa_out: *u8, slen_inout: *i32): usize {
    return accept(sock, sa_out, slen_inout)
}

pub fn pal_sock_connect(sock: usize, sa: *const u8, slen: i32): bool {
    return connect(sock, sa, slen) == 0
}

pub fn pal_sock_send(sock: usize, buf: *const u8, count: usize): i64 {
    var chunk = count
    if chunk > 0x7FFF_FFFF {
        chunk = 0x7FFF_FFFF
    }
    var n = send(sock, buf, i32(chunk), 0)
    if n < 0 {
        return -1
    }
    return i64(n)
}

pub fn pal_sock_recv(sock: usize, buf: *u8, count: usize): i64 {
    var chunk = count
    if chunk > 0x7FFF_FFFF {
        chunk = 0x7FFF_FFFF
    }
    var n = recv(sock, buf, i32(chunk), 0)
    if n < 0 {
        return -1
    }
    return i64(n)
}

pub fn pal_sock_sendto(sock: usize, buf: *const u8, count: usize, sa: *const u8, slen: i32): i64 {
    var n = sendto(sock, buf, i32(count), 0, sa, slen)
    if n < 0 {
        return -1
    }
    return i64(n)
}

pub fn pal_sock_recvfrom(sock: usize, buf: *u8, count: usize, sa_out: *u8, slen_inout: *i32): i64 {
    var n = recvfrom(sock, buf, i32(count), 0, sa_out, slen_inout)
    if n < 0 {
        return -1
    }
    return i64(n)
}

pub fn pal_sock_getsockname(sock: usize, sa_out: *u8, slen_inout: *i32): bool {
    return getsockname(sock, sa_out, slen_inout) == 0
}

pub fn pal_sock_getpeername(sock: usize, sa_out: *u8, slen_inout: *i32): bool {
    return getpeername(sock, sa_out, slen_inout) == 0
}

pub fn pal_sock_shutdown_write(sock: usize): bool {
    return shutdown(sock, PAL_NET_SD_SEND) == 0
}

// Resolves `host_cstr` to a network-byte-order IPv4 `u32` via Winsock `getaddrinfo`.
pub fn pal_dns_resolve_ipv4(host_cstr: *const u8, out_ip_net: *u32): bool {
    var hints = WinAddrInfoA { ai_family: PAL_NET_AF_INET, ai_socktype: PAL_NET_SOCK_STREAM }
    var res_ptr: usize = 0
    var rc = getaddrinfo(host_cstr, null, ptr_cast(*const u8, &hints), &res_ptr)
    if rc != 0 || res_ptr == 0 {
        return false
    }
    defer freeaddrinfo(res_ptr)

    var cur = res_ptr
    loop cur != 0 {
        var ai = ptr_cast(*const WinAddrInfoA, cur)
        if ai.ai_family == PAL_NET_AF_INET && ai.ai_addr != null {
            var sa = ptr_cast(*const WinSockAddrIn, ai.ai_addr)
            *out_ip_net = sa.sin_addr
            return true
        }
        cur = usize(ai.ai_next)
    }
    return false
}
