// =============================================================================
// Antimony PAL: std/pal/time_linux.sb
// Linux POSIX CLOCK_MONOTONIC and nanosleep primitives.
// =============================================================================

const CLOCK_MONOTONIC: i32 = 1

priv struct Timespec {
    tv_sec: i64
    tv_nsec: i64
}

priv extern "libc.so.6" {
    fn clock_gettime(clk_id: i32, tp: *Timespec): i32
    fn nanosleep(req: *const Timespec, rem: *Timespec): i32
}

pub fn pal_ticks_ms(): u64 {
    var ts = Timespec {}
    clock_gettime(CLOCK_MONOTONIC, &ts)
    return u64(ts.tv_sec) * 1000 + u64(ts.tv_nsec) / 1_000_000
}

pub fn pal_perf_counter(): i64 {
    var ts = Timespec {}
    clock_gettime(CLOCK_MONOTONIC, &ts)
    return ts.tv_sec * 1_000_000_000 + ts.tv_nsec
}

pub fn pal_perf_freq(): i64 {
    return 1_000_000_000
}

pub fn pal_sleep_ms(ms: u32) {
    var req = Timespec {
        tv_sec: i64(ms) / 1000,
        tv_nsec: (i64(ms) % 1000) * 1_000_000,
    }
    nanosleep(&req, null)
}
