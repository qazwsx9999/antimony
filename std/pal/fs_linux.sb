// =============================================================================
// Antimony PAL: std/pal/fs_linux.sb
// Linux POSIX filesystem metadata, directory ops, and opendir/readdir iteration.
// =============================================================================

import "std/mem.sb"
import "std/str.sb"

const PAL_FS_F_OK: i32 = 0
const PAL_FS_DT_DIR: u8 = 4
const PAL_FS_DT_REG: u8 = 8
const PAL_FS_O_RDONLY: i32 = 0
const PAL_FS_O_WRONLY: i32 = 1
const PAL_FS_O_CREAT: i32 = 0x40
const PAL_FS_O_TRUNC: i32 = 0x200
const PAL_FS_SEEK_END: i32 = 2

// Exact Linux x86-64 glibc `struct dirent` layout (d_name starts at offset 19).
priv struct LinuxDirent {
    d_ino: u64
    d_off: i64
    d_reclen: u16
    d_type: u8
    d_name[256]: u8
}

priv extern "libc.so.6" {
    fn access(path: *const u8, mode: i32): i32
    fn mkdir(path: *const u8, mode: u32): i32
    fn rmdir(path: *const u8): i32
    fn unlink(path: *const u8): i32
    fn rename(oldpath: *const u8, newpath: *const u8): i32
    fn opendir(name: *const u8): isize
    fn readdir(dirp: isize): *const u8
    fn closedir(dirp: isize): i32
    fn open(path: *const u8, flags: i32, mode: u32): i32
    fn read(fd: i32, buf: *u8, count: usize): isize
    fn write(fd: i32, buf: *const u8, count: usize): isize
    fn lseek(fd: i32, offset: i64, whence: i32): i64
    fn close(fd: i32): i32
    fn __errno_location(): *i32
}

pub const PAL_INVALID_DIR_HANDLE: isize = -1

pub fn pal_fs_exists(path: *const u8): bool {
    return access(path, PAL_FS_F_OK) == 0
}

pub fn pal_fs_is_dir(path: *const u8): bool {
    var d = opendir(path)
    if d != 0 {
        closedir(d)
        return true
    }
    return false
}

pub fn pal_fs_is_file(path: *const u8): bool {
    if access(path, PAL_FS_F_OK) != 0 {
        return false
    }
    return !pal_fs_is_dir(path)
}

pub fn pal_fs_mkdir(path: *const u8): bool {
    return mkdir(path, 0x1ED) == 0
}

pub fn pal_fs_rmdir(path: *const u8): bool {
    return rmdir(path) == 0
}

pub fn pal_fs_remove_file(path: *const u8): bool {
    return unlink(path) == 0
}

pub fn pal_fs_rename(src: *const u8, dst: *const u8): bool {
    return rename(src, dst) == 0
}

pub fn pal_fs_copy(src: *const u8, dst: *const u8): bool {
    var sfd = open(src, PAL_FS_O_RDONLY, 0)
    if sfd < 0 {
        return false
    }
    defer close(sfd)

    var dfd = open(dst, PAL_FS_O_WRONLY | PAL_FS_O_CREAT | PAL_FS_O_TRUNC, 0x1A4)
    if dfd < 0 {
        return false
    }
    defer close(dfd)

    var buf[4096]: u8
    loop {
        var n = read(sfd, &buf[0], 4096)
        if n < 0 {
            return false
        }
        if n == 0 {
            return true
        }
        var off: isize = 0
        loop off < n {
            var w = write(dfd, &buf[off], usize(n - off))
            if w <= 0 {
                return false
            }
            off += w
        }
    }
}

pub fn pal_dir_open(path: str, raw_buf: *u8, out_handle: *isize, out_has_pending: *bool): i32 {
    var _unused_buf = raw_buf
    var pb: StringBuilder
    pb.init(usize(len(path)) + 1)
    defer pb.free()
    pb.append(path)

    var d = opendir(pb.cstr())
    if d == 0 {
        return -1
    }
    *out_handle = d
    *out_has_pending = false
    return 0
}

priv fn probe_linux_entry_size(full_path: *const u8): i64 {
    var fd = open(full_path, PAL_FS_O_RDONLY, 0)
    if fd < 0 {
        return 0
    }
    var sz = lseek(fd, 0, PAL_FS_SEEK_END)
    close(fd)
    if sz < 0 {
        return 0
    }
    return sz
}

pub fn pal_dir_next(
    handle: *isize,
    raw_buf: *u8,
    has_pending: *bool,
    dir_path: *const u8,
    dir_path_len: i64,
    out_name: *u8,
    out_name_len: *i64,
    out_size: *i64,
    out_is_dir: *bool
): i32 {
    var _unused_buf = raw_buf
    if *handle == PAL_INVALID_DIR_HANDLE || *handle == 0 {
        return 0
    }
    var dirp = *handle
    loop {
        var ep = __errno_location()
        *ep = 0
        var raw_ent = readdir(dirp)
        if raw_ent == null {
            var err = *ep
            pal_dir_close(handle, has_pending)
            if err != 0 {
                return -1
            }
            return 0
        }
        var ent = ptr_cast(*const LinuxDirent, raw_ent)
        var nm = cstr_to_str(&ent.d_name[0])
        if nm == "." || nm == ".." {
            continue
        }
        var n = i64(cstr_len(&ent.d_name[0]))
        if n > 259 {
            n = 259
        }
        if n > 0 {
            copy_mem(out_name, &ent.d_name[0], usize(n))
        }
        out_name[n] = 0
        *out_name_len = n

        // Build full child path for size / DT_UNKNOWN directory fallback
        var fp: StringBuilder
        fp.init(usize(dir_path_len) + usize(n) + 2)
        defer fp.free()
        if dir_path_len > 0 {
            fp.append(str_from_ptr(dir_path, usize(dir_path_len)))
            if dir_path[dir_path_len - 1] != '/' {
                fp.append_byte('/')
            }
        }
        fp.append(nm)

        var is_d = false
        if ent.d_type == PAL_FS_DT_DIR {
            is_d = true
        } else if ent.d_type == PAL_FS_DT_REG {
            is_d = false
        } else {
            is_d = pal_fs_is_dir(fp.cstr())
        }
        *out_is_dir = is_d
        if is_d {
            *out_size = 0
        } else {
            *out_size = probe_linux_entry_size(fp.cstr())
        }
        return 1
    }
}

pub fn pal_dir_close(handle: *isize, has_pending: *bool) {
    if *handle != PAL_INVALID_DIR_HANDLE && *handle != 0 {
        closedir(*handle)
        *handle = PAL_INVALID_DIR_HANDLE
    }
    *has_pending = false
}
