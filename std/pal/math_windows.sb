// =============================================================================
// Antimony PAL: std/pal/math_windows.sb
// Windows msvcrt.dll math bindings and IEEE-754 classification helpers.
// =============================================================================

pub extern "msvcrt.dll" {
    // Double-precision (f64)
    fn sqrt(x: f64): f64
    fn sin(x: f64): f64
    fn cos(x: f64): f64
    fn tan(x: f64): f64
    fn asin(x: f64): f64
    fn acos(x: f64): f64
    fn atan(x: f64): f64
    fn atan2(y: f64, x: f64): f64
    fn sinh(x: f64): f64
    fn cosh(x: f64): f64
    fn tanh(x: f64): f64
    fn exp(x: f64): f64
    fn log(x: f64): f64
    fn log10(x: f64): f64
    fn pow(base: f64, exp: f64): f64
    fn floor(x: f64): f64
    fn ceil(x: f64): f64
    fn fmod(x: f64, y: f64): f64
    fn fabs(x: f64): f64
    fn ldexp(x: f64, exp: i32): f64
    fn frexp(x: f64, exp: *i32): f64
    fn modf(x: f64, iptr: *f64): f64

    // Single-precision (f32)
    fn sqrtf(x: f32): f32
    fn sinf(x: f32): f32
    fn cosf(x: f32): f32
    fn tanf(x: f32): f32
    fn powf(base: f32, exp: f32): f32
    fn floorf(x: f32): f32
    fn ceilf(x: f32): f32
    fn fmodf(x: f32, y: f32): f32
}

priv extern "msvcrt.dll" {
    fn _hypot(x: f64, y: f64): f64
    fn _copysign(mag: f64, sgn: f64): f64
    fn _isnan(x: f64): i32
    fn _finite(x: f64): i32
}

pub fn hypot(x: f64, y: f64): f64 {
    return _hypot(x, y)
}

pub fn copysign(mag: f64, sgn: f64): f64 {
    return _copysign(mag, sgn)
}

pub fn pal_is_nan(x: f64): bool {
    return _isnan(x) != 0
}

pub fn pal_is_finite(x: f64): bool {
    return _finite(x) != 0
}
