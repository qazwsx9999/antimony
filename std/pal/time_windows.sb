// =============================================================================
// Antimony PAL: std/pal/time_windows.sb
// Win32 monotonic performance counter and sleep primitives.
// =============================================================================

priv extern "kernel32.dll" {
    fn GetTickCount64(): u64
    fn QueryPerformanceCounter(lpPerformanceCount: *i64): i32
    fn QueryPerformanceFrequency(lpFrequency: *i64): i32
    fn Sleep(dwMilliseconds: u32)
}

pub fn pal_ticks_ms(): u64 {
    return GetTickCount64()
}

pub fn pal_perf_counter(): i64 {
    var c: i64 = 0
    QueryPerformanceCounter(&c)
    return c
}

pub fn pal_perf_freq(): i64 {
    var f: i64 = 1
    QueryPerformanceFrequency(&f)
    return f
}

pub fn pal_sleep_ms(ms: u32) {
    Sleep(ms)
}
