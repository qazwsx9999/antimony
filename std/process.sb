// =============================================================================
// Antimony Standard Library: std/process.sb
// Cross-platform child process spawning, waiting, termination, and stdout/stderr
// pipe capture (`Child`, `process_spawn`, `process_run`, `process_capture`).
// =============================================================================

import "std/core.sb"
import "std/io.sb"
import "std/str.sb"
import "std/pal/process.sb"

// Returns the OS process ID of the current process.
pub fn current_pid(): u32 {
    return pal_current_pid()
}

// Handle to a spawned child process.
pub struct Child {
    process: isize
    thread: isize
    pid: u32
}

pub fn (c: *Child) is_open(): bool {
    return pal_proc_is_open(c.process)
}

// Closes the child's OS handles without waiting for it to exit.
pub fn (c: *Child) close() {
    pal_proc_close(&c.process, &c.thread)
}

// Waits for the child process to exit, closes its handles, and returns its exit code.
pub fn (c: *Child) wait(): Result[u32, IoError] {
    if !c.is_open() {
        return .Err(.InvalidInput)
    }
    var code: u32 = 0
    if pal_proc_wait(&c.process, &c.thread, &code) != 0 {
        return .Err(io_error_from_os(pal_last_os_error()))
    }
    return .Ok(code)
}

// Non-blocking poll: returns `.Ok(.Some(code))` if exited, `.Ok(.None)` if still running.
pub fn (c: *Child) try_wait(): Result[Option[u32], IoError] {
    if !c.is_open() {
        return .Err(.InvalidInput)
    }
    var code: u32 = 0
    var rc = pal_proc_try_wait(&c.process, &c.thread, &code)
    if rc == 0 {
        return .Ok(.None)
    }
    if rc < 0 {
        return .Err(io_error_from_os(pal_last_os_error()))
    }
    return .Ok(.Some(code))
}

// Forcefully terminates the child process with `exit_code`.
pub fn (c: *Child) kill(exit_code: u32): Result[bool, IoError] {
    if !c.is_open() {
        return .Err(.InvalidInput)
    }
    if !pal_proc_kill(c.process, exit_code) {
        return .Err(io_error_from_os(pal_last_os_error()))
    }
    return .Ok(true)
}

// Spawns a child process executing `cmd` (inheriting stdin/stdout/stderr).
pub fn process_spawn(cmd: str): Result[Child, IoError] {
    if len(cmd) == 0 {
        return .Err(.InvalidInput)
    }
    var ph: isize = 0
    var th: isize = 0
    var pid: u32 = 0
    if !pal_proc_spawn(cmd, &ph, &th, &pid) {
        return .Err(io_error_from_os(pal_last_os_error()))
    }
    return .Ok(Child {
            process: ph,
            thread: th,
            pid: pid
    })
}

// Spawns `cmd`, waits for it to finish, and returns its exit code.
pub fn process_run(cmd: str): Result[u32, IoError] {
    var child = process_spawn(cmd)?
    return child.wait()
}

// Spawns `cmd`, captures its combined stdout and stderr into `out`, waits for
// completion, and returns the child's exit code.
pub fn process_capture(cmd: str, out: *StringBuilder): Result[u32, IoError] {
    if len(cmd) == 0 {
        return .Err(.InvalidInput)
    }
    var code: u32 = 0
    if !pal_proc_capture(cmd, out, &code) {
        return .Err(io_error_from_os(pal_last_os_error()))
    }
    return .Ok(code)
}
