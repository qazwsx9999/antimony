// =============================================================================
// Antimony Standard Library: std/thread.sb
// Cross-platform OS threads, mutexes, reader-writer locks, condition variables,
// and hardware atomic operations (`AtomicI64`).
// =============================================================================

import "std/pal/thread.sb"

// -----------------------------------------------------------------------------
// OS Thread (`Thread`)
// -----------------------------------------------------------------------------

pub struct Thread {
    handle: usize
    id: u32
}

// Spawns a new OS thread executing `entry(arg)`.
pub fn spawn(entry: fn(*u8): u32, arg: *u8): Thread {
    var tid: u32 = 0
    var h = pal_thread_spawn(entry, arg, &tid)
    return Thread { handle: h, id: tid }
}

pub fn (t: *Thread) is_valid(): bool {
    return t.handle != 0
}

// Waits for the thread to terminate, releases its OS handle, and returns its exit code.
pub fn (t: *Thread) join(): u32 {
    if t.handle == 0 {
        return 0
    }
    var code = pal_thread_join(t.handle)
    t.handle = 0
    return code
}

// Detaches the thread without waiting for completion.
pub fn (t: *Thread) detach() {
    if t.handle != 0 {
        pal_thread_detach(t.handle)
        t.handle = 0
    }
}

pub fn current_thread_id(): u32 {
    return pal_current_thread_id()
}

// -----------------------------------------------------------------------------
// Mutex (`Mutex` — Win32 SRWLOCK / Linux pthread_mutex_t)
// -----------------------------------------------------------------------------

pub struct Mutex {
    storage[8]: usize
}

pub fn (m: *Mutex) init() {
    pal_mutex_init(&m.storage[0])
}

pub fn (m: *Mutex) lock() {
    pal_mutex_lock(&m.storage[0])
}

pub fn (m: *Mutex) unlock() {
    pal_mutex_unlock(&m.storage[0])
}

pub fn (m: *Mutex) try_lock(): bool {
    return pal_mutex_try_lock(&m.storage[0])
}

// -----------------------------------------------------------------------------
// Reader-Writer Lock (`RwLock` — Win32 SRWLOCK / Linux pthread_rwlock_t)
// -----------------------------------------------------------------------------

pub struct RwLock {
    storage[8]: usize
}

pub fn (rw: *RwLock) init() {
    pal_rwlock_init(&rw.storage[0])
}

pub fn (rw: *RwLock) read_lock() {
    pal_rwlock_read_lock(&rw.storage[0])
}

pub fn (rw: *RwLock) read_unlock() {
    pal_rwlock_read_unlock(&rw.storage[0])
}

pub fn (rw: *RwLock) try_read_lock(): bool {
    return pal_rwlock_try_read_lock(&rw.storage[0])
}

pub fn (rw: *RwLock) write_lock() {
    pal_rwlock_write_lock(&rw.storage[0])
}

pub fn (rw: *RwLock) write_unlock() {
    pal_rwlock_write_unlock(&rw.storage[0])
}

pub fn (rw: *RwLock) try_write_lock(): bool {
    return pal_rwlock_try_write_lock(&rw.storage[0])
}

// -----------------------------------------------------------------------------
// Condition Variable (`CondVar` — Win32 CONDITION_VARIABLE / Linux pthread_cond_t)
// -----------------------------------------------------------------------------

pub struct CondVar {
    storage[8]: usize
}

pub fn (c: *CondVar) init() {
    pal_cond_init(&c.storage[0])
}

pub fn (c: *CondVar) wait(m: *Mutex) {
    pal_cond_wait(&c.storage[0], &m.storage[0])
}

// Waits up to `timeout_ms` milliseconds; returns true if signaled, false on timeout.
pub fn (c: *CondVar) wait_timeout(m: *Mutex, timeout_ms: u32): bool {
    return pal_cond_wait_timeout(&c.storage[0], &m.storage[0], timeout_ms)
}

pub fn (c: *CondVar) notify_one() {
    pal_cond_notify_one(&c.storage[0])
}

pub fn (c: *CondVar) notify_all() {
    pal_cond_notify_all(&c.storage[0])
}

// -----------------------------------------------------------------------------
// 64-Bit Hardware Atomic Integer (`AtomicI64`)
// -----------------------------------------------------------------------------

pub struct AtomicI64 {
    val: i64
}

pub fn (a: *AtomicI64) init(v: i64) {
    atomic_store(&a.val, v)
}

pub fn (a: *AtomicI64) load(): i64 {
    return atomic_load(&a.val)
}

pub fn (a: *AtomicI64) store(v: i64) {
    atomic_store(&a.val, v)
}

pub fn (a: *AtomicI64) fetch_add(delta: i64): i64 {
    return atomic_add(&a.val, delta)
}

pub fn (a: *AtomicI64) fetch_sub(delta: i64): i64 {
    return atomic_add(&a.val, -delta)
}

pub fn (a: *AtomicI64) cas(expected: i64, desired: i64): bool {
    return atomic_cas(&a.val, expected, desired) == expected
}
