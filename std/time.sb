// =============================================================================
// Antimony Standard Library: std/time.sb
// Cross-platform high-resolution monotonic timers, Stopwatch, and sleep utilities.
// =============================================================================

import "std/pal/time.sb"

// Returns monotonic milliseconds elapsed.
pub fn ticks_ms(): u64 {
    return pal_ticks_ms()
}

// Returns the current high-resolution performance counter tick.
pub fn perf_counter(): i64 {
    return pal_perf_counter()
}

// Returns the frequency (ticks per second) of the high-resolution performance counter.
pub fn perf_freq(): i64 {
    return pal_perf_freq()
}

// Returns elapsed microseconds between two `perf_counter()` readings.
pub fn elapsed_us(start: i64, end: i64): i64 {
    var f = perf_freq()
    var diff = end - start
    if f == 1_000_000_000 {
        return diff / 1000
    }
    var secs = diff / f
    var rem = diff % f
    return secs * 1_000_000 + (rem * 1_000_000) / f
}

// Returns elapsed milliseconds between two `perf_counter()` readings.
pub fn elapsed_ms(start: i64, end: i64): f64 {
    var f = perf_freq()
    return f64(end - start) * 1000.0 / f64(f)
}

// Suspends execution of the current thread for `ms` milliseconds.
pub fn sleep_ms(ms: u32) {
    pal_sleep_ms(ms)
}

// Simple monotonic stopwatch backed by `perf_counter()`.
pub struct Stopwatch {
    start_tick: i64
}

pub fn stopwatch_start(): Stopwatch {
    return Stopwatch { start_tick: perf_counter() }
}

pub fn (sw: *Stopwatch) reset() {
    sw.start_tick = perf_counter()
}

pub fn (sw: Stopwatch) elapsed_us(): i64 {
    return elapsed_us(sw.start_tick, perf_counter())
}

pub fn (sw: Stopwatch) elapsed_ms(): f64 {
    return elapsed_ms(sw.start_tick, perf_counter())
}
