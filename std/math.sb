// =============================================================================
// Antimony Standard Library: std/math.sb
// Cross-platform mathematical constants, IEEE-754 float utilities, hardware-backed
// transcendental functions (f64 / f32), interpolation, and integer math.
// =============================================================================

import "std/pal/math.sb"

// -----------------------------------------------------------------------------
// Fundamental Constants (untyped float constants adapt to f32 or f64)
// -----------------------------------------------------------------------------

pub const PI = 3.14159265358979323846
pub const TAU = 6.28318530717958647692
pub const HALF_PI = 1.57079632679489661923
pub const QUARTER_PI = 0.78539816339744830962
pub const INV_PI = 0.31830988618379067154

pub const E = 2.71828182845904523536
pub const LN2 = 0.69314718055994530942
pub const LN10 = 2.30258509299404568402
pub const LOG2E = 1.44269504088896340736
pub const LOG10E = 0.43429448190325182765

pub const SQRT2 = 1.41421356237309504880
pub const SQRT1_2 = 0.70710678118654752440
pub const PHI = 1.61803398874989484820

pub const DEG_TO_RAD = 0.01745329251994329577
pub const RAD_TO_DEG = 57.29577951308232087680

pub const INF = 1.0 / 0.0
pub const NEG_INF = -1.0 / 0.0
pub const NAN = 0.0 / 0.0

pub const EPSILON_F64: f64 = 2.220446049250313e-16
pub const EPSILON_F32: f32 = 1.1920929e-7

pub const I64_MAX: i64 = 9223372036854775807
pub const I64_MIN: i64 = -9223372036854775808
pub const U64_MAX: u64 = 18446744073709551615
pub const I32_MAX: i32 = 2147483647
pub const I32_MIN: i32 = -2147483648
pub const U32_MAX: u32 = 4294967295

// -----------------------------------------------------------------------------
// Generic Comparison & Clamping Helpers
// -----------------------------------------------------------------------------

// Returns the smaller of `a` and `b`.
pub fn min[T](a: T, b: T): T {
    if a < b {
        return a
    }
    return b
}

// Returns the larger of `a` and `b`.
pub fn max[T](a: T, b: T): T {
    if a > b {
        return a
    }
    return b
}

// Clamps `x` to the closed interval `[lo, hi]`.
pub fn clamp[T](x: T, lo: T, hi: T): T {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

// -----------------------------------------------------------------------------
// Floating-Point Classification, Rounding & Extended Operations
// -----------------------------------------------------------------------------

pub fn is_nan(x: f64): bool {
    return pal_is_nan(x)
}

pub fn is_finite(x: f64): bool {
    return pal_is_finite(x)
}

pub fn is_inf(x: f64): bool {
    return !is_nan(x) && !is_finite(x)
}

pub fn fabsf(x: f32): f32 {
    if x <= 0.0 {
        if x == 0.0 {
            return 0.0
        }
        return -x
    }
    return x
}

// Rounds `x` to the nearest integer value (halfway cases away from zero).
pub fn round(x: f64): f64 {
    if x >= 0.0 {
        return floor(x + 0.5)
    }
    return ceil(x - 0.5)
}

pub fn roundf(x: f32): f32 {
    if x >= 0.0 {
        return floorf(x + 0.5)
    }
    return ceilf(x - 0.5)
}

// Truncates `x` toward zero.
pub fn trunc(x: f64): f64 {
    if x >= 0.0 {
        return floor(x)
    }
    return ceil(x)
}

pub fn truncf(x: f32): f32 {
    if x >= 0.0 {
        return floorf(x)
    }
    return ceilf(x)
}

// Signed fractional part: `x - trunc(x)`.
pub fn fract(x: f64): f64 {
    return x - trunc(x)
}

// Returns -1.0, 0.0 (preserving -0.0/NaN), or +1.0.
pub fn sign(x: f64): f64 {
    if x > 0.0 {
        return 1.0
    }
    if x < 0.0 {
        return -1.0
    }
    return x
}

// Cube root with Newton-Raphson refinement for full f64 accuracy.
pub fn cbrt(x: f64): f64 {
    if x == 0.0 || !is_finite(x) {
        return x
    }
    var neg = x < 0.0
    var ax = fabs(x)
    var y = pow(ax, 1.0 / 3.0)
    // Two Halley/Newton steps refine pow(ax, 1/3) to machine precision.
    y = y - (y * y * y - ax) / (3.0 * y * y)
    y = y - (y * y * y - ax) / (3.0 * y * y)
    if neg {
        return -y
    }
    return y
}

pub fn exp2(x: f64): f64 {
    return pow(2.0, x)
}

pub fn log2(x: f64): f64 {
    return log(x) * LOG2E
}

// Computes `exp(x) - 1.0` accurately even when `x` is very close to 0.
pub fn expm1(x: f64): f64 {
    if fabs(x) < 1.0e-5 {
        return x + x * x * (0.5 + x * (1.0 / 6.0 + x * (1.0 / 24.0)))
    }
    return exp(x) - 1.0
}

// Computes `log(1.0 + x)` accurately even when `x` is very close to 0.
pub fn log1p(x: f64): f64 {
    if fabs(x) < 1.0e-5 {
        return x - x * x * (0.5 - x * ((1.0 / 3.0) - x * 0.25))
    }
    return log(1.0 + x)
}

// -----------------------------------------------------------------------------
// Interpolation, Angles & Approximate Equality
// -----------------------------------------------------------------------------

pub fn deg_to_rad(deg: f64): f64 {
    return deg * DEG_TO_RAD
}

pub fn rad_to_deg(rad: f64): f64 {
    return rad * RAD_TO_DEG
}

// Linear interpolation between `a` and `b` at parameter `t`.
pub fn lerp(a: f64, b: f64, t: f64): f64 {
    return a + (b - a) * t
}

// Inverse linear interpolation: returns `t` such that `lerp(a, b, t) == v`.
pub fn inv_lerp(a: f64, b: f64, v: f64): f64 {
    if a == b {
        return 0.0
    }
    return (v - a) / (b - a)
}

// Maps `v` from range `[in_lo, in_hi]` into `[out_lo, out_hi]`.
pub fn remap(in_lo: f64, in_hi: f64, out_lo: f64, out_hi: f64, v: f64): f64 {
    return lerp(out_lo, out_hi, inv_lerp(in_lo, in_hi, v))
}

// Smooth Hermite interpolation in `[0, 1]` between `edge0` and `edge1`.
pub fn smoothstep(edge0: f64, edge1: f64, x: f64): f64 {
    var t = clamp(inv_lerp(edge0, edge1, x), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)
}

pub fn approx_eq(a: f64, b: f64, eps: f64): bool {
    return fabs(a - b) <= eps
}

pub fn approx_eq_f32(a: f32, b: f32, eps: f32): bool {
    return fabsf(a - b) <= eps
}

// -----------------------------------------------------------------------------
// Integer Math & Bit Utilities
// -----------------------------------------------------------------------------

pub fn abs_i64(x: i64): i64 {
    if x < 0 {
        return -x
    }
    return x
}

pub fn abs_i32(x: i32): i32 {
    if x < 0 {
        return -x
    }
    return x
}

pub fn sign_i64(x: i64): i64 {
    if x > 0 {
        return 1
    }
    if x < 0 {
        return -1
    }
    return 0
}

// Greatest common divisor (always non-negative).
pub fn gcd(a: i64, b: i64): i64 {
    var x = abs_i64(a)
    var y = abs_i64(b)
    loop y != 0 {
        var r = x % y
        x = y
        y = r
    }
    return x
}

// Least common multiple (always non-negative; divides before multiplying to avoid overflow).
pub fn lcm(a: i64, b: i64): i64 {
    if a == 0 || b == 0 {
        return 0
    }
    return (abs_i64(a) / gcd(a, b)) * abs_i64(b)
}

// Integer exponentiation by squaring (`exp >= 0`).
pub fn pow_i64(base: i64, exp: i64): i64 {
    if exp < 0 {
        if base == 1 {
            return 1
        }
        if base == -1 {
            if (exp & 1) == 0 {
                return 1
            }
            return -1
        }
        return 0
    }
    var result: i64 = 1
    var b = base
    var e = exp
    loop e > 0 {
        if (e & 1) != 0 {
            result *= b
        }
        e >>= 1
        if e > 0 {
            b *= b
        }
    }
    return result
}

pub fn is_pow2(n: u64): bool {
    return n != 0 && (n & (n - 1)) == 0
}

// Smallest power of 2 >= `n` (returns 0 if result overflows `u64`).
pub fn next_pow2(n: u64): u64 {
    if n <= 1 {
        return 1
    }
    if n > 0x8000000000000000 {
        return 0
    }
    var v = n - 1
    v |= v >> 1
    v |= v >> 2
    v |= v >> 4
    v |= v >> 8
    v |= v >> 16
    v |= v >> 32
    return v + 1
}

// Integer floor(log2(n)) for `n > 0`, or -1 if `n == 0`.
pub fn ilog2(n: u64): i32 {
    if n == 0 {
        return -1
    }
    var r: i32 = 0
    var v = n
    if (v >> 32) != 0 {
        v >>= 32
        r += 32
    }
    if (v >> 16) != 0 {
        v >>= 16
        r += 16
    }
    if (v >> 8) != 0 {
        v >>= 8
        r += 8
    }
    if (v >> 4) != 0 {
        v >>= 4
        r += 4
    }
    if (v >> 2) != 0 {
        v >>= 2
        r += 2
    }
    if (v >> 1) != 0 {
        r += 1
    }
    return r
}

// Ceiling division for unsigned integers (`b > 0`).
pub fn div_ceil_u64(a: u64, b: u64): u64 {
    if a == 0 {
        return 0
    }
    return ((a - 1) / b) + 1
}
