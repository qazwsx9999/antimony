// =============================================================================
// Antimony Standard Library: std/fs.sb
// Cross-platform filesystem operations (`exists`, `is_file`, `is_dir`, `mkdir`,
// `rmdir`, `remove_file`, `rename`, `copy`, `fs_read_dir`) returning `Result`.
// =============================================================================

import "std/core.sb"
import "std/mem.sb"
import "std/io.sb"
import "std/str.sb"
import "std/pal/fs.sb"

// Returns true if a file or directory exists at `path`.
pub fn fs_exists(path: str): bool {
    if len(path) == 0 {
        return false
    }
    var pb: StringBuilder
    pb.init(usize(len(path)) + 1)
    defer pb.free()
    pb.append(path)
    return pal_fs_exists(pb.cstr())
}

// Returns true if `path` exists and is a directory.
pub fn fs_is_dir(path: str): bool {
    if len(path) == 0 {
        return false
    }
    var pb: StringBuilder
    pb.init(usize(len(path)) + 1)
    defer pb.free()
    pb.append(path)
    return pal_fs_is_dir(pb.cstr())
}

// Returns true if `path` exists and is a regular (non-directory) file.
pub fn fs_is_file(path: str): bool {
    if len(path) == 0 {
        return false
    }
    var pb: StringBuilder
    pb.init(usize(len(path)) + 1)
    defer pb.free()
    pb.append(path)
    return pal_fs_is_file(pb.cstr())
}

// Creates a single directory at `path`.
pub fn fs_mkdir(path: str): Result[bool, IoError] {
    if len(path) == 0 {
        return .Err(.InvalidInput)
    }
    var pb: StringBuilder
    pb.init(usize(len(path)) + 1)
    defer pb.free()
    pb.append(path)
    if !pal_fs_mkdir(pb.cstr()) {
        return .Err(io_error_from_os(pal_last_os_error()))
    }
    return .Ok(true)
}

// Removes an empty directory at `path`.
pub fn fs_rmdir(path: str): Result[bool, IoError] {
    if len(path) == 0 {
        return .Err(.InvalidInput)
    }
    var pb: StringBuilder
    pb.init(usize(len(path)) + 1)
    defer pb.free()
    pb.append(path)
    if !pal_fs_rmdir(pb.cstr()) {
        return .Err(io_error_from_os(pal_last_os_error()))
    }
    return .Ok(true)
}

// Deletes the file at `path`.
pub fn fs_remove_file(path: str): Result[bool, IoError] {
    if len(path) == 0 {
        return .Err(.InvalidInput)
    }
    var pb: StringBuilder
    pb.init(usize(len(path)) + 1)
    defer pb.free()
    pb.append(path)
    if !pal_fs_remove_file(pb.cstr()) {
        return .Err(io_error_from_os(pal_last_os_error()))
    }
    return .Ok(true)
}

// Renames or moves `src` to `dst` (replacing `dst` if it already exists).
pub fn fs_rename(src: str, dst: str): Result[bool, IoError] {
    if len(src) == 0 || len(dst) == 0 {
        return .Err(.InvalidInput)
    }
    var sb1: StringBuilder
    sb1.init(usize(len(src)) + 1)
    defer sb1.free()
    sb1.append(src)

    var sb2: StringBuilder
    sb2.init(usize(len(dst)) + 1)
    defer sb2.free()
    sb2.append(dst)

    if !pal_fs_rename(sb1.cstr(), sb2.cstr()) {
        return .Err(io_error_from_os(pal_last_os_error()))
    }
    return .Ok(true)
}

// Copies `src` to `dst` (overwriting `dst` if it exists).
pub fn fs_copy(src: str, dst: str): Result[bool, IoError] {
    if len(src) == 0 || len(dst) == 0 {
        return .Err(.InvalidInput)
    }
    var sb1: StringBuilder
    sb1.init(usize(len(src)) + 1)
    defer sb1.free()
    sb1.append(src)

    var sb2: StringBuilder
    sb2.init(usize(len(dst)) + 1)
    defer sb2.free()
    sb2.append(dst)

    if !pal_fs_copy(sb1.cstr(), sb2.cstr()) {
        return .Err(io_error_from_os(pal_last_os_error()))
    }
    return .Ok(true)
}

// -----------------------------------------------------------------------------
// Directory Iteration (`fs_read_dir`, `DirIter`, `DirEntry`)
// -----------------------------------------------------------------------------

pub struct DirEntry {
    name_buf[260]: u8
    name_len: i64
    size: i64
    is_dir: bool
}

// Returns a zero-copy `str` view of the entry's filename (valid while `e` lives).
pub fn (e: *DirEntry) name(): str {
    if e.name_len <= 0 {
        return ""
    }
    return str(e.name_buf[0..e.name_len])
}

pub struct DirIter {
    handle: isize
    raw_find[320]: u8
    dir_path[512]: u8
    dir_path_len: i64
    has_pending: bool
}

// Opens a directory iterator over all entries in `path` (automatically skipping "." and "..").
pub fn fs_read_dir(path: str): Result[DirIter, IoError] {
    if len(path) == 0 {
        return .Err(.InvalidInput)
    }
    var it = DirIter { handle: PAL_INVALID_DIR_HANDLE, dir_path_len: 0, has_pending: false }
    var plen = len(path)
    if plen > 511 {
        plen = 511
    }
    if plen > 0 {
        copy_mem(&it.dir_path[0], ptr_cast(*const u8, path), usize(plen))
    }
    it.dir_path[plen] = 0
    it.dir_path_len = plen

    if pal_dir_open(path, &it.raw_find[0], &it.handle, &it.has_pending) != 0 {
        return .Err(io_error_from_os(pal_last_os_error()))
    }
    return .Ok(it)
}

// Advances the iterator, populating `out` with the next entry.
// Returns `.Ok(true)` if an entry was produced, or `.Ok(false)` when finished.
pub fn (it: *DirIter) next(out: *DirEntry): Result[bool, IoError] {
    var rc = pal_dir_next(
        &it.handle,
        &it.raw_find[0],
        &it.has_pending,
        &it.dir_path[0],
        it.dir_path_len,
        &out.name_buf[0],
        &out.name_len,
        &out.size,
        &out.is_dir
    )
    if rc < 0 {
        return .Err(io_error_from_os(pal_last_os_error()))
    }
    return .Ok(rc > 0)
}

pub fn (it: *DirIter) close() {
    pal_dir_close(&it.handle, &it.has_pending)
}
