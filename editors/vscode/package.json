{
  "name": "antimony",
  "displayName": "Antimony (sb)",
  "description": "Built-in LSP (sbc lsp) for Go to Definition, compiler-backed Hover, Completion, Live Diagnostics, Outline, Formatting (sbc fmt), Snippets, and Build/Run/Test for Antimony (.sb).",
  "version": "0.3.0",
  "publisher": "antimony-lang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "antimony",
    "sb",
    "syntax",
    "language"
  ],
  "activationEvents": [
    "onLanguage:antimony"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "antimony",
        "aliases": [
          "Antimony",
          "antimony",
          "sb"
        ],
        "extensions": [
          ".sb"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/sb-light.svg",
          "dark": "./icons/sb-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "antimony",
        "scopeName": "source.sb",
        "path": "./syntaxes/antimony.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "antimony",
        "path": "./snippets/antimony.json"
      }
    ],
    "commands": [
      {
        "command": "antimony.runFile",
        "title": "Antimony: Compile & Run Current File",
        "icon": "$(play)"
      },
      {
        "command": "antimony.buildFile",
        "title": "Antimony: Compile Current File",
        "icon": "$(tools)"
      },
      {
        "command": "antimony.checkFile",
        "title": "Antimony: Type-Check Current File",
        "icon": "$(check)"
      },
      {
        "command": "antimony.testFile",
        "title": "Antimony: Run Tests in Current File (sbc test)",
        "icon": "$(beaker)"
      },
      {
        "command": "antimony.formatFile",
        "title": "Antimony: Format Current File (sbc fmt)",
        "icon": "$(wand)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "antimony.runFile",
          "when": "editorLangId == antimony",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Antimony",
      "properties": {
        "antimony.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Antimony compiler (sbc / sbc.exe). Leave empty to auto-detect sbc.exe in the workspace root or PATH."
        },
        "antimony.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Show live compiler diagnostics for open Antimony files."
        },
        "antimony.enableLsp": {
          "type": "boolean",
          "default": true,
          "description": "Use the built-in `sbc lsp` language server for live diagnostics, Go to Definition, Hover, Completion, Outline, and Formatting."
        }
      }
    }
  }
}
