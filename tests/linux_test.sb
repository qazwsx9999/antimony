struct Vec2 {
    x: i64
    y: i64
}

fn (v: *Vec2) add(dx: i64, dy: i64) {
    v.x += dx
    v.y += dy
}

fn (v: Vec2) dot(other: Vec2): i64 {
    return v.x * other.x + v.y * other.y
}

enum CalcErr {
    DivByZero
}

fn safe_div(a: i64, b: i64): Result[i64, CalcErr] {
    if b == 0 {
        return .Err(.DivByZero)
    }
    return .Ok(a / b)
}

fn compute_ratio(a: i64, b: i64): Result[i64, CalcErr] {
    var q = safe_div(a, b)?
    return .Ok(q * 2)
}

fn apply_op(a: i32, b: i32, op: fn(i32, i32): i32): i32 {
    return op(a, b)
}

fn test_core_language_and_try() {
    var p = Vec2 { x: 3, y: 4 }
    p.add(1, 2)
    assert_eq(p.x, i64(4), "Vec2.x")
    assert_eq(p.y, i64(6), "Vec2.y")
    assert_eq(p.dot(Vec2 { x: 2, y: 3 }), i64(26), "Vec2.dot")

    var a: i64 = 100
    var b: i64 = 200
    swap(&a, &b)
    assert_eq(a, i64(200), "swap a")
    assert_eq(b, i64(100), "swap b")

    assert_eq(assert_ok(compute_ratio(20, 4), "ratio ok"), i64(10), "ratio val")
    assert_err(compute_ratio(20, 0), "ratio div0")

    var o1: Option[str] = .Some("linux-and-windows")
    var o2: Option[str] = .None
    assert_eq(assert_some(o1, "opt some"), "linux-and-windows", "opt val")
    assert_none(o2, "opt none")

    var res = apply_op(6, 7, fn(x: i32, y: i32): i32 { return x * y })
    assert_eq(res, 42, "anonymous fn ptr")

    var counter: i64 = 10
    var prev = atomic_add(&counter, 5)
    assert_eq(prev, i64(10), "atomic_add prev")
    assert_eq(atomic_load(&counter), i64(15), "atomic_load")
    assert_eq(atomic_cas(&counter, 15, 99), i64(15), "atomic_cas prev")
    assert_eq(atomic_load(&counter), i64(99), "atomic_cas val")

    var log: i32 = 0
    if true {
        defer { log = log * 10 + 1 }
        defer { log = log * 10 + 2 }
    }
    assert_eq(log, 21, "defer LIFO")
}

fn test_mem_and_arena() {
    var buf = alloc(32)
    assert_true(buf != null, "alloc non-null")
    defer free_mem(buf)
    assert_eq(buf[0], u8(0), "alloc zero-init 0")
    assert_eq(buf[31], u8(0), "alloc zero-init 31")

    set_mem(buf, 0x5A, 16)
    assert_eq(buf[0], u8(0x5A), "set_mem 0")
    assert_eq(buf[15], u8(0x5A), "set_mem 15")
    assert_eq(buf[16], u8(0), "set_mem 16 untouched")

    copy_mem(buf + 16, buf, 16)
    assert_true(eq_mem(buf, buf + 16, 16), "copy_mem + eq_mem")

    var resized = realloc_mem(buf, 64)
    assert_true(resized != null, "realloc_mem")
    buf = resized
    assert_eq(buf[0], u8(0x5A), "realloc preserves prefix")

    var arena: Arena
    arena.init(256)
    defer arena.free()
    var p1 = arena.alloc(24, 8)
    var p2 = arena.alloc(40, 16)
    assert_true(p1 != null && p2 != null, "arena allocs")
    assert_true(arena.remaining() < 256, "arena remaining decreased")
}

fn test_collections_and_sort() {
    // Vec
    var v: Vec[i32]
    v.init(2)
    defer v.free()
    var seed[3]: i32 = [10, 20, 30]
    v.extend_slice(seed)
    v.insert(1, 15)
    assert_eq(v.remove(1), 15, "vec remove")
    assert_eq(v.swap_remove(0), 10, "vec swap_remove")
    assert_eq(v.len, i64(2), "vec len")
    assert_none(v.try_get(99), "vec oob")

    // HashMap
    var m: HashMap[str, i64]
    m.init(8)
    defer m.free()
    m.put("alpha", 1)
    m.put("beta", 2)
    assert_eq(assert_some(m.get("beta"), "map get"), i64(2), "map val")
    var ptr = m.get_ptr("alpha")
    *ptr = 99
    assert_eq(assert_some(m.take("alpha"), "map take"), i64(99), "map take val")
    assert_false(m.contains("alpha"), "map removed")

    // HashSet
    var hs: HashSet[i32]
    hs.init(8)
    defer hs.free()
    assert_true(hs.insert(5), "set insert")
    assert_false(hs.insert(5), "set dup")
    assert_true(hs.contains(5), "set contains")
    assert_true(hs.remove(5), "set remove")

    // Deque
    var dq: Deque[i32]
    dq.init(4)
    defer dq.free()
    dq.push_back(2)
    dq.push_front(1)
    dq.push_back(3)
    assert_eq(assert_some(dq.pop_front(), "dq front"), 1, "dq front val")
    assert_eq(assert_some(dq.pop_back(), "dq back"), 3, "dq back val")

    // BinaryHeap & MinHeap
    var maxh: BinaryHeap[i32]
    maxh.init(4)
    defer maxh.free()
    var minh: MinHeap[i32]
    minh.init(4)
    defer minh.free()
    var nums[5]: i32 = [4, 1, 9, 2, 7]
    loop x in nums {
        maxh.push(x)
        minh.push(x)
    }
    assert_eq(assert_some(maxh.pop(), "maxh"), 9, "maxh top")
    assert_eq(assert_some(minh.pop(), "minh"), 1, "minh top")

    // Sort & binary search
    var arr[7]: i32 = [9, 1, 5, 3, 5, 8, 2]
    sort(arr)
    assert_true(is_sorted(arr), "sort ascending")
    assert_eq(lower_bound(arr, 5), i64(3), "lower_bound")
    assert_eq(upper_bound(arr, 5), i64(5), "upper_bound")
    assert_eq(binary_search(arr, 8), i64(5), "binary_search")
    sort_desc(arr)
    assert_eq(arr[0], 9, "sort_desc first")
    assert_eq(arr[6], 1, "sort_desc last")
}

fn test_str_and_path() {
    assert_true(str_contains("antimony-cross", "cross"), "str_contains")
    assert_str_contains("antimony-linux-x64", "linux", "assert_str_contains")
    assert_eq(str_count("ababa", "ab"), i64(2), "str_count")
    assert_true(str_eq_ignore_ascii_case("SbLang", "sblang"), "ignore_case")
    assert_eq(assert_ok(try_parse_i64(" -9223372036854775808 "), "i64 min"), -9223372036854775808, "i64 min val")
    assert_err(try_parse_u64("18446744073709551616"), "u64 overflow")
    assert_approx(assert_ok(try_parse_f64("-3.25e2"), "f64"), -325.0, 1.0e-9, "f64 val")

    var sb: StringBuilder
    sb.init(32)
    defer sb.free()
    sb.append_replace("a-b-c", "-", "::")
    sb.append(" 0x")
    sb.append_hex(255)
    assert_eq(sb.as_str(), "a::b::c 0xff", "sb replace+hex")

    // Pure-Antimony C-string helpers (zero FFI)
    var cs = sb.cstr()
    assert_eq(cstr_len(cs), usize(12), "cstr_len")
    assert_eq(cstr_to_str(cs), "a::b::c 0xff", "cstr_to_str")
    var sb2: StringBuilder
    sb2.init(16)
    defer sb2.free()
    sb2.append("a::b::c 0xff")
    assert_true(cstr_eq(cs, sb2.cstr()), "cstr_eq true")
    sb2.append("!")
    assert_false(cstr_eq(cs, sb2.cstr()), "cstr_eq false")

    // Path helpers
    assert_eq(path_basename("/usr/local/bin/sbc"), "sbc", "posix basename")
    assert_eq(path_dirname("/usr/local/bin/sbc"), "/usr/local/bin", "posix dirname")
    assert_eq(path_extension("/src/main.sb"), ".sb", "extension")
    assert_eq(path_stem("/src/main.sb"), "main", "stem")
    assert_true(path_is_abs("/usr/bin"), "posix abs")
    assert_false(path_is_abs("std/mem.sb"), "rel path")
}

fn test_math_time_and_rand() {
    // Math (msvcrt.dll on Windows, libm.so.6 on Linux)
    assert_approx(sqrt(144.0), 12.0, 1.0e-12, "sqrt")
    assert_approx(sin(HALF_PI), 1.0, 1.0e-12, "sin")
    assert_approx(cos(PI), -1.0, 1.0e-12, "cos")
    assert_approx(pow(2.0, 10.0), 1024.0, 1.0e-12, "pow")
    assert_approx(hypot(3.0, 4.0), 5.0, 1.0e-12, "hypot")
    assert_approx(copysign(3.5, -1.0), -3.5, 1.0e-12, "copysign")
    assert_approx(cbrt(-27.0), -3.0, 1.0e-12, "cbrt")
    assert_true(is_nan(NAN), "is_nan")
    assert_false(is_finite(INF), "is_finite INF")
    assert_true(is_inf(NEG_INF), "is_inf NEG_INF")
    assert_true(is_finite(42.0), "is_finite 42")
    assert_eq(gcd(48, -18), i64(6), "gcd")
    assert_eq(lcm(12, 18), i64(36), "lcm")
    assert_eq(next_pow2(1000), u64(1024), "next_pow2")
    assert_eq(ilog2(1024), 10, "ilog2")

    // Time (QueryPerformanceCounter on Windows, clock_gettime on Linux)
    assert_true(perf_freq() > 0, "perf_freq > 0")
    var t0 = ticks_ms()
    var sw = stopwatch_start()
    sleep_ms(10)
    var dt_us = sw.elapsed_us()
    var dt_ms = sw.elapsed_ms()
    var t1 = ticks_ms()
    assert_true(dt_us >= 1000, "elapsed_us >= 1ms")
    assert_true(dt_ms >= 1.0, "elapsed_ms >= 1.0")
    assert_true(t1 >= t0, "ticks_ms monotonic")

    // Rand (BCryptGenRandom on Windows, getrandom on Linux)
    var r1 = rng_from_seed(777)
    var r2 = rng_from_seed(777)
    assert_eq(r1.next_u64(), r2.next_u64(), "rng deterministic")
    var ri = r1.range_i64(10, 20)
    assert_true(ri >= 10 && ri < 20, "rng range")
    var rbytes[16]: u8 = []
    assert_true(os_random_bytes(rbytes), "os csprng")
    var os_rng = rng_from_os()
    assert_ne(os_rng.next_u64(), u64(0), "rng_from_os")
}

fn test_encoding_hash_and_json() {
    // Hex & Base64
    var hb: StringBuilder
    hb.init(32)
    defer hb.free()
    hex_encode_str("Hi!", &hb)
    assert_eq(hb.as_str(), "486921", "hex encode")

    var b64: StringBuilder
    b64.init(32)
    defer b64.free()
    base64_encode_str("foobar", &b64)
    assert_eq(b64.as_str(), "Zm9vYmFy", "base64 encode")

    // CRC32 & SHA-256
    assert_eq(crc32_str("123456789"), u32(0xCBF43926), "crc32 vector")
    var dig = sha256_str("abc")
    var sh: StringBuilder
    sh.init(64)
    defer sh.free()
    dig.to_hex(&sh)
    assert_eq(sh.as_str(), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "sha256 abc")

    // JSON parse & stringify round-trip
    var doc: JsonDoc
    doc.init()
    defer doc.free()
    var root = assert_ok(json_parse(`{"os":"linux-x64","ok":true,"nums":[1,2,3]}`, &doc), "json parse")
    assert_eq(assert_some(doc.as_str(assert_some(doc.get(root, "os"), "os key")), "os str"), "linux-x64", "json os")
    assert_true(assert_some(doc.as_bool(assert_some(doc.get(root, "ok"), "ok key")), "ok bool"), "json ok")
    var arr = assert_some(doc.get(root, "nums"), "nums key")
    assert_eq(assert_some(doc.as_i64(assert_some(doc.at(arr, 2), "nums[2]")), "nums[2] i64"), i64(3), "json nums[2]")

    var out: StringBuilder
    out.init(64)
    defer out.free()
    doc.stringify(root, &out)
    assert_eq(out.as_str(), `{"os":"linux-x64","ok":true,"nums":[1,2,3]}`, "json stringify")
    assert_err(json_parse(`{"bad": }`, &doc), "malformed json")
}

fn test_io_bufio_fs_and_os() {
    // OS: cwd, args, env
    var cwd_buf[512]: u8 = []
    var cwd = assert_some(cwd_into(cwd_buf), "cwd_into")
    assert_true(len(cwd) > 0, "cwd non-empty")
    assert_true(arg_count() >= 1, "arg_count >= 1")
    assert_true(len(arg_at(0)) > 0, "arg_at(0) non-empty")
    assert_true(len(cmd_line()) > 0, "cmd_line non-empty")

    var env_buf[4096]: u8 = []
    var path_env = assert_some(getenv_str("PATH", env_buf), "getenv PATH")
    assert_true(len(path_env) > 0, "PATH non-empty")
    assert_none(getenv_str("__ANTIMONY_DEFINITELY_UNSET_99__", env_buf), "unset env")

    // FS + IO: mkdir, write, read, seek, append, copy, rename, read_dir, remove
    var dir = "sb_cross_io_tmp"
    var f1 = "sb_cross_io_tmp/a.txt"
    var f2 = "sb_cross_io_tmp/b.txt"
    var f3 = "sb_cross_io_tmp/c.txt"
    var f4 = "sb_cross_io_tmp/lines.txt"

    if !fs_exists(dir) {
        assert_ok(fs_mkdir(dir), "fs_mkdir")
    }
    assert_true(fs_exists(dir), "dir exists")
    assert_true(fs_is_dir(dir), "dir is_dir")
    assert_false(fs_is_file(dir), "dir not is_file")

    assert_ok(write_file_all(f1, "hello cross-platform\n"), "write_file_all")
    assert_true(fs_is_file(f1), "f1 is_file")
    assert_false(fs_is_dir(f1), "f1 not is_dir")

    var af = assert_ok(file_open_append(f1), "file_open_append")
    assert_ok(af.write_str("second line\n"), "append write")
    assert_ok(af.flush(), "file flush")
    af.close()

    var content: StringBuilder
    content.init(64)
    defer content.free()
    var nread = assert_ok(read_file_all(f1, &content), "read_file_all")
    assert_eq(nread, i64(33), "read_file_all len")
    assert_eq(content.as_str(), "hello cross-platform\nsecond line\n", "read_file_all text")

    var rf = assert_ok(file_open(f1), "file_open")
    assert_eq(assert_ok(rf.size(), "file size"), i64(33), "file size val")
    assert_eq(assert_ok(rf.seek(.Start(6)), "seek start"), i64(6), "seek pos")
    var slice_buf[5]: u8 = []
    assert_eq(assert_ok(rf.read(slice_buf), "read 5"), i64(5), "read 5 len")
    assert_eq(str(slice_buf), "cross", "seek+read text")
    rf.close()

    assert_ok(fs_copy(f1, f2), "fs_copy")
    assert_true(fs_exists(f2), "f2 exists after copy")
    assert_ok(fs_rename(f2, f3), "fs_rename")
    assert_false(fs_exists(f2), "f2 gone after rename")
    assert_true(fs_exists(f3), "f3 exists after rename")

    // Missing file returns .Err(.NotFound)
    match file_open("sb_cross_io_tmp/does_not_exist.txt") {
        .Ok(_) { assert_true(false, "expected NotFound error") }
        .Err(e) {
            match e {
                .NotFound {}
                else { assert_true(false, "expected IoError.NotFound") }
            }
        }
    }

    // BufWriter + BufReader
    var bwf = assert_ok(file_create(f4), "bufio file_create")
    var bw: BufWriter
    bw.init(&bwf, 16)
    defer bw.free()
    assert_ok(bw.write_str("one\r\ntwo\nthree"), "bw write")
    assert_ok(bw.flush(), "bw flush")
    bwf.close()

    var brf = assert_ok(file_open(f4), "bufio file_open")
    var br: BufReader
    br.init(&brf, 16)
    defer br.free()
    var line: StringBuilder
    line.init(32)
    defer line.free()
    assert_true(assert_ok(br.read_line(&line), "line 1"), "has line 1")
    assert_eq(line.as_str(), "one", "line 1 val")
    assert_true(assert_ok(br.read_line(&line), "line 2"), "has line 2")
    assert_eq(line.as_str(), "two", "line 2 val")
    assert_true(assert_ok(br.read_line(&line), "line 3"), "has line 3")
    assert_eq(line.as_str(), "three", "line 3 val")
    assert_false(assert_ok(br.read_line(&line), "eof"), "at eof")
    brf.close()

    // Directory iteration
    var it = assert_ok(fs_read_dir(dir), "fs_read_dir")
    var entry = DirEntry {}
    var seen_a = false
    var seen_c = false
    var seen_lines = false
    var count: i64 = 0
    loop assert_ok(it.next(&entry), "dir next") {
        count += 1
        var nm = entry.name()
        if nm == "a.txt" {
            seen_a = true
            assert_false(entry.is_dir, "a.txt not dir")
            assert_eq(entry.size, i64(33), "a.txt size")
        } else if nm == "c.txt" {
            seen_c = true
        } else if nm == "lines.txt" {
            seen_lines = true
        }
    }
    it.close()
    assert_eq(count, i64(3), "dir entry count")
    assert_true(seen_a && seen_c && seen_lines, "dir entries found")

    // Cleanup
    assert_ok(fs_remove_file(f1), "rm f1")
    assert_ok(fs_remove_file(f3), "rm f3")
    assert_ok(fs_remove_file(f4), "rm f4")
    assert_ok(fs_rmdir(dir), "rmdir")
    assert_false(fs_exists(dir), "dir cleaned up")
}

struct SharedCounter {
    mtx: Mutex
    cv: CondVar
    total: i64
    ready: bool
    atom: AtomicI64
}

fn worker_increment(raw: *u8): u32 {
    var sc = ptr_cast(*SharedCounter, raw)
    loop _ in 0..500 {
        sc.mtx.lock()
        sc.total += 1
        sc.mtx.unlock()
        sc.atom.fetch_add(1)
    }
    return 77
}

fn worker_signal_cond(raw: *u8): u32 {
    var sc = ptr_cast(*SharedCounter, raw)
    sleep_ms(10)
    sc.mtx.lock()
    sc.ready = true
    sc.cv.notify_one()
    sc.mtx.unlock()
    return 1
}

fn test_threads_locks_and_condvar() {
    assert_ne(current_thread_id(), u32(0), "current_thread_id")

    var sc = SharedCounter {}
    sc.mtx.init()
    sc.cv.init()
    sc.atom.init(0)

    var t1 = spawn(worker_increment, ptr_cast(*u8, &sc))
    var t2 = spawn(worker_increment, ptr_cast(*u8, &sc))
    var t3 = spawn(worker_increment, ptr_cast(*u8, &sc))
    var t4 = spawn(worker_increment, ptr_cast(*u8, &sc))
    assert_true(t1.is_valid() && t2.is_valid() && t3.is_valid() && t4.is_valid(), "threads valid")
    assert_eq(t1.join(), u32(77), "t1 exit")
    assert_eq(t2.join(), u32(77), "t2 exit")
    assert_eq(t3.join(), u32(77), "t3 exit")
    assert_eq(t4.join(), u32(77), "t4 exit")
    assert_eq(sc.total, i64(2000), "mutex total")
    assert_eq(sc.atom.load(), i64(2000), "atomic total")

    // RwLock
    var rw = RwLock {}
    rw.init()
    assert_true(rw.try_read_lock(), "rw try_read_lock")
    assert_true(rw.try_read_lock(), "rw nested read_lock")
    rw.read_unlock()
    rw.read_unlock()
    assert_true(rw.try_write_lock(), "rw try_write_lock")
    assert_false(rw.try_read_lock(), "rw read blocked while write held")
    rw.write_unlock()

    // CondVar signal + timeout
    sc.mtx.lock()
    assert_false(sc.cv.wait_timeout(&sc.mtx, 5), "condvar timeout")
    sc.mtx.unlock()

    var ts = spawn(worker_signal_cond, ptr_cast(*u8, &sc))
    sc.mtx.lock()
    loop !sc.ready {
        sc.cv.wait(&sc.mtx)
    }
    sc.mtx.unlock()
    assert_eq(ts.join(), u32(1), "condvar signaler exit")
    assert_true(sc.ready, "condvar ready")
}

fn test_process_and_pid() {
    assert_true(current_pid() > 0, "current_pid > 0")

    var cwd_buf[512]: u8 = []
    var cwd = assert_some(cwd_into(cwd_buf), "proc cwd")
    var is_win = len(cwd) >= 2 && cwd[1] == ':'

    var cmd = "echo cross-proc-ok"
    var ok_cmd = "exit 0"
    if is_win {
        cmd = "cmd.exe /c echo cross-proc-ok"
        ok_cmd = "cmd.exe /c exit 0"
    }

    var pout: StringBuilder
    pout.init(64)
    defer pout.free()
    var rc = assert_ok(process_capture(cmd, &pout), "process_capture")
    assert_eq(rc, u32(0), "capture exit 0")
    assert_eq(str_trim(pout.as_str()), "cross-proc-ok", "capture stdout")

    var run_rc = assert_ok(process_run(ok_cmd), "process_run")
    assert_eq(run_rc, u32(0), "process_run exit 0")
}

struct MiniHttpServer {
    listener: TcpListener
}

fn mini_http_worker(raw: *u8): u32 {
    var srv = ptr_cast(*MiniHttpServer, raw)
    match srv.listener.accept() {
        .Ok(conn) {
            var s = conn
            defer s.close()
            var req: HttpRequest
            req.init()
            defer req.free()
            match http_read_request(&s, &req) {
                .Ok(_) {
                    var res: HttpResponse
                    res.init(200)
                    defer res.free()
                    if req.path == "/ping" {
                        res.set_json(`{"ok":true}`)
                    } else {
                        res.set_json(`{"ok":false}`)
                    }
                    var wr = http_write_response(&s, &res)
                    match wr {
                        .Ok(_) { return 0 }
                        .Err(_) { return 3 }
                    }
                }
                .Err(_) { return 1 }
            }
        }
        .Err(_) { return 2 }
    }
}

fn test_net_and_http_loopback() {
    // DNS resolve localhost
    var lh = assert_ok(dns_resolve("localhost"), "dns localhost")
    assert_true(lh.eq(ipv4_localhost()), "localhost == 127.0.0.1")

    // UDP loopback
    var u = assert_ok(udp_bind(socket_addr(ipv4_localhost(), 0)), "udp_bind")
    defer u.close()
    var uaddr = assert_ok(u.local_addr(), "udp local_addr")
    assert_eq(assert_ok(u.send_str_to("ping-udp", uaddr), "udp send"), i64(8), "udp sent 8")
    var ubuf[64]: u8 = []
    var pkt = assert_ok(u.recv_from(ubuf), "udp recv")
    assert_eq(pkt.len, i64(8), "udp recv len")
    assert_eq(str(ubuf[0..pkt.len]), "ping-udp", "udp recv payload")

    // Multithreaded HTTP/1.1 client & server loopback
    var listener = assert_ok(tcp_bind(socket_addr(ipv4_localhost(), 0)), "tcp_bind")
    var laddr = assert_ok(listener.local_addr(), "listener local_addr")
    var srv = MiniHttpServer { listener: listener }
    var th = spawn(mini_http_worker, ptr_cast(*u8, &srv))
    assert_true(th.is_valid(), "http server thread valid")

    var url_sb: StringBuilder
    url_sb.init(64)
    defer url_sb.free()
    url_sb.append("http://127.0.0.1:")
    url_sb.append_u64(u64(laddr.port))
    url_sb.append("/ping")

    var resp: HttpClientResponse
    resp.init()
    defer resp.free()
    var status = assert_ok(http_get(url_sb.as_str(), &resp), "http_get loopback")
    assert_eq(status, 200, "http status 200")
    assert_eq(resp.body, `{"ok":true}`, "http json body")

    assert_eq(th.join(), u32(0), "http server thread exit 0")
    srv.listener.close()
}
