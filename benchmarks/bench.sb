// examples/bench.sb - Antimony Stage 2 Performance Benchmark Suite
// Exercises:
//   1. AST function inlining + power-of-two strength reduction (*, /, %)
//   2. Multi-register XMM0-XMM5 floating-point evaluation (Mandelbrot kernel)
//   3. Range-loop bounds-check elimination on arrays & slices
//   4. Generic quicksort (std/sort.sb + std/vec.sb)

import "../std/time.sb"
import "../std/vec.sb"
import "../std/sort.sb"

fn clamp_i64(x: i64, lo: i64, hi: i64): i64 {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

fn mix_step(x: i64, i: i64): i64 {
    var v = clamp_i64(i & 1023, 10, 900)
    return (x + v * 16) - (i / 8) + (i % 64)
}

fn bench_inline_and_strength(iters: i64): i64 {
    var acc: i64 = 0
    loop i in 0..iters {
        acc = mix_step(acc, i)
    }
    return acc
}

fn mandelbrot_point(cr: f64, ci: f64, max_iter: i32): i32 {
    var zr = 0.0
    var zi = 0.0
    var it = 0
    loop it < max_iter {
        var zr2 = zr * zr
        var zi2 = zi * zi
        if zr2 + zi2 > 4.0 {
            return it
        }
        zi = 2.0 * zr * zi + ci
        zr = zr2 - zi2 + cr
        it += 1
    }
    return max_iter
}

fn bench_mandelbrot(size: i32, max_iter: i32): i64 {
    var total: i64 = 0
    var inv = 1.0 / f64(size)
    loop y in 0..size {
        var ci = (f64(y) * inv) * 2.0 - 1.0
        loop x in 0..size {
            var cr = (f64(x) * inv) * 3.5 - 2.5
            total += i64(mandelbrot_point(cr, ci, max_iter))
        }
    }
    return total
}

fn sum_slice_bce(s: []i64, rounds: i32): i64 {
    var total: i64 = 0
    loop r in 0..rounds {
        loop i in 0..len(s) {
            total += s[i] * 4 + i64(r & 7)
        }
    }
    return total
}

fn bench_quicksort(n: i64): i64 {
    var v: Vec[i64]
    v.init(n)
    defer v.free()

    var state: u64 = 0x1234_5678_9ABC_DEF0
    loop i in 0..n {
        state = state * 6364136223846793005 + 1442695040888963407
        v.push(i64(state >> 16))
    }

    var s = v.as_slice()
    sort(s)
    return s[0] ^ s[n / 2] ^ s[n - 1]
}

fn main() {
    print("=== Antimony Stage 2 Benchmark Suite ===")

    // 1. Inlined functions + strength reduction (50M iterations)
    var t0 = perf_counter()
    var r1 = bench_inline_and_strength(50_000_000)
    var t1 = perf_counter()
    print("1. Inlining + Strength Reduction (50M iters) [us]:")
    print(elapsed_us(t0, t1))
    print(r1)

    // 2. XMM0-XMM5 Floating-Point Mandelbrot (1000x1000 grid, max_iter=100)
    var t2 = perf_counter()
    var r2 = bench_mandelbrot(1000, 100)
    var t3 = perf_counter()
    print("2. XMM Float Mandelbrot (1000x1000, 100 max_iter) [us]:")
    print(elapsed_us(t2, t3))
    print(r2)

    // 3. Range-Loop Bounds-Check Elimination (1024-element slice x 50,000 rounds = 51.2M accesses)
    var buf: Vec[i64]
    buf.init(1024)
    defer buf.free()
    loop i in 0..1024 {
        buf.push(i64(i * 3 + 1))
    }
    var t4 = perf_counter()
    var r3 = sum_slice_bce(buf.as_slice(), 50_000)
    var t5 = perf_counter()
    print("3. Range-Loop Slice BCE (51.2M indexed loads) [us]:")
    print(elapsed_us(t4, t5))
    print(r3)

    // 4. Generic Quicksort (200,000 random i64 elements)
    var t6 = perf_counter()
    var r4 = bench_quicksort(200_000)
    var t7 = perf_counter()
    print("4. Generic Quicksort (200,000 i64s) [us]:")
    print(elapsed_us(t6, t7))
    print(r4)
}
